# ============================================================================
# Selene Edge Functions — local environment variables (template)
# ============================================================================
# Copy this file to `.env` in this folder and fill the values. Used by
# `bun run functions:serve` and the local stack. `.env` is gitignored; never
# commit real values. Production values are Supabase function secrets
# (`supabase secrets set`); the full list is in docs/go-live.md, "6. Edge
# Function secrets". SUPABASE_URL and the Supabase keys are injected by the stack.

# --- Stripe (sandbox / test mode keys only) ---
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-secret

# --- Sentry (optional locally; without a DSN nothing is reported) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- Cron callers ---
# Shared secret that cron-invoked functions compare against the `x-cron-secret`
# header. Any random value locally (`openssl rand -hex 32`); `bun run bruno:env`
# copies it into bruno/.env.
CRON_SECRET=your-random-secret

# --- Expo Push API (dispatch-push) ---
# Access token from https://expo.dev/settings/access-tokens, created with the
# account that owns the EAS project. Required once "Enhanced Security for Push
# Notifications" is on. Use a separate token per environment.
# Without it, dispatch-push answers 500 MISSING_SERVER_CONFIG and claims nothing.
EXPO_ACCESS_TOKEN=your-expo-access-token

# Stripe sandbox connected account the Bruno sandbox scenarios release to
# (Custom MX test account, created with the Stripe CLI; see #332).
# Test mode only; not a secret, but specific to this sandbox.
BRUNO_STRIPE_TEST_ACCOUNT_ID=acct_your_sandbox_test_account

# Exact origins (scheme://host[:port], no trailing slash) of the admin-web, comma-separated.
# Only the functions the admin-web calls send CORS headers, and only to these origins;
# missing or empty means no origin is allowed. Production: the deployed admin-web URL.
# See supabase/functions/AGENTS.md, "CORS".
ADMIN_WEB_ORIGINS=admin_domain_or_localhost:port


# Envia tracking webhook signing secret (HMAC-SHA256 over X-Webhook-Signature).
# Local: any random value (openssl rand -hex 32); `bun run bruno:env` copies it
# so the signed bruno/functions/envia-webhook-signed-*.bru requests run.
# Remote: the secret Envia issues for the registered sandbox webhook.
ENVIA_WEBHOOK_SECRET_SANDBOX=

# HTTPS bridge Stripe returns to after hosted Connect onboarding; it redirects
# to the app's selene:// deep link. Required when SUPABASE_URL is plain http
# (local stack). Use the deployed connect-onboarding-return function, e.g.
# https://<project-ref>.supabase.co/functions/v1/connect-onboarding-return
SELENE_CONNECT_ONBOARDING_BRIDGE_URL=
