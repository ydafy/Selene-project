meta {
  name: t5-setup-dispute-d6
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/rest/v1/disputes?id=eq.{{t5Disp6}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "waiting_return",
    "return_payout_status": "pending"
  }
}

tests {
  test("d6 waits for the return label payment", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("waiting_return");
  });
}

docs {
  Local stack only. d6: approved return whose label payment fn_log_return_payment records. It must be logged before fn_cron_dispute_payout_timeout runs, which would otherwise take d6 like d7.
}
