meta {
  name: t5-verdict-as-admin-notices
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/rest/v1/notifications?or=(source_event_key.like.dispute.verdict:{{t5Disp4}}:*,source_event_key.eq.dispute.opened:{{t5Disp4}})&select=user_id,event_kind,action_path&order=event_kind,user_id
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the seller and the buyer are notified once", function () {
    expect(res.getStatus()).to.equal(200);
    const verdicts = res.getBody().filter((n) => n.event_kind === "dispute.verdict");
    expect(verdicts.map((n) => n.user_id)).to.deep.equal(["00000000-0000-4000-8000-000000000004", "00000000-0000-4000-8000-000000000005"]);
  });

  test("T13: the opened and verdict notices open the disputed shipment, not the order summary", function () {
    const rows = res.getBody();
    expect(rows.filter((n) => n.event_kind === "dispute.opened").map((n) => n.user_id)).to.deep.equal(["00000000-0000-4000-8000-000000000004"]);
    expect(rows.length).to.equal(3);
    for (const n of rows) {
      expect(n.action_path).to.equal("/profile/orders/" + bru.getVar("t5Order") + "?shipment_id=" + bru.getVar("t5Ship4"));
    }
  });
}

docs {
  One verdict notice per participant, plus the seller's dispute.opened notice written when the setup inserted the dispute. Every link names the disputed shipment (T13).
}
