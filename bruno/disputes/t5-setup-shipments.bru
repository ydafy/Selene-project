tests {
  test("nine delivered shipments exist and only s2 is not Connect", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().length).to.equal(9);
    const legacy = res.getBody().filter((s) => s.stripe_payment_intent_id === null);
    expect(legacy.length).to.equal(1);
    expect(legacy[0].id).to.equal(bru.getVar("t5Ship2"));
  });
}

docs {
  Local stack only. s1 confirmation (Connect), s2 no payment intent (refused), s3 release (Connect), s4 admin verdict, s5 verdict without a session, s6 return payment, s7 payout timeout, s8 shipping timeout, s9 return-delivery timeout. All delivered three days ago; the payment intent ids are fake.
}
