meta {
  name: t5-setup-shipments
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/rest/v1/shipments
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

