meta {
  name: t5-cleanup-disputes
  type: http
  seq: 35
}

patch {
  url: {{baseUrl}}/rest/v1/disputes?id=in.({{t5Disp5}},{{t5Disp6}})
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "resolved"
  }
}

tests {
  test("the open disputes of this run are closed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(2);
  });
}

docs {
  Local stack only. d5 (refused) and d6 (return_shipped) would otherwise keep their shipments out of other crons for ever.
}
