meta {
  name: noconnect-payout-timeout-logged-error
  type: http
  seq: 63
}

get {
  url: {{baseUrl}}/rest/v1/system_logs?metadata->>dispute_id=eq.{{ncDispA}}&select=level,message,metadata
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("no system_logs row names the dispute", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  fn_cron_dispute_payout_timeout records the manual-intervention failure of the waiting_return dispute in internal.ops_failures (odd/tasks/table-cleanup.md S6a), not in system_logs. That schema is not exposed over REST, so refunds.test.sql and dispute_return_timeouts.test.sql pin the row; this request proves nothing reaches system_logs.
}
