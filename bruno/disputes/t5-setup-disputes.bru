tests {
  test("six open disputes exist for s4-s9", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().length).to.equal(6);
  });
}

docs {
  Local stack only. fn_notify_dispute_opened accepts only service-role inserts of open disputes, so they start open; the next requests move d6-d9 to the states the functions look for. updated_at is three days ago.
}
