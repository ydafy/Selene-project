meta {
  name: t5-setup-disputes
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/rest/v1/disputes
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

