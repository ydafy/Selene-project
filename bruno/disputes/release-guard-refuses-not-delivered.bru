meta {
  name: release-guard-refuses-not-delivered
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_release_shipment_funds
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_shipment_id": "{{rgShip1}}"
  }
}

tests {
  test("a shipment that is not delivered is refused", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: false, error_message: "SHIPMENT_NOT_DELIVERED" }]);
  });
}

docs {
  Service role, the only role with EXECUTE (anon and buyer: auth/rpc-fn-release-shipment-funds-as-*-denied).
}
