meta {
  name: release-guard-cron-refused-log
  type: http
  seq: 48
}

get {
  url: {{baseUrl}}/rest/v1/system_logs?metadata->>dispute_id=eq.{{rgDisp5}}&select=level,message,metadata
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("no system_logs row names the dispute", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  The refused release is recorded as a RELEASE_REFUSED row in internal.ops_failures (odd/tasks/table-cleanup.md S6a), not in system_logs. That schema is not exposed over REST, so shipment_funds_release.test.sql pins the row; this request proves nothing reaches system_logs.
}
