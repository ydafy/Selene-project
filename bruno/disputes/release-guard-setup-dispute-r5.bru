meta {
  name: release-guard-setup-dispute-r5
  type: http
  seq: 40
}

patch {
  url: {{baseUrl}}/rest/v1/disputes?id=eq.{{rgDisp5}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "waiting_return",
    "return_payout_status": "paid"
  }
}

tests {
  test("the r5 dispute waits for the buyer to ship the return", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("waiting_return");
    expect(res.getBody()[0].return_payout_status).to.equal("paid");
  });
}

docs {
  Local stack only. Label paid, no tracking number for more than 48 h: fn_cron_dispute_shipping_timeout selects it.
}
