meta {
  name: noconnect-return-delivery-logged-error
  type: http
  seq: 64
}

get {
  url: {{baseUrl}}/rest/v1/system_logs?metadata->>dispute_id=eq.{{ncDispB}}&select=level,message,metadata
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("no system_logs row names the dispute", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  fn_cron_return_delivery_timeout counts the return_delivered dispute in total_errors and records its manual-intervention failure in internal.ops_failures (odd/tasks/table-cleanup.md S6a), not in system_logs. That schema is not exposed over REST, so refunds.test.sql and dispute_return_timeouts.test.sql pin the row; this request proves nothing reaches system_logs.
}
