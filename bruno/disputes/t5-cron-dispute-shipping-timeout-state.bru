meta {
  name: t5-cron-dispute-shipping-timeout-state
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/rest/v1/disputes?id=eq.{{t5Disp8}}&select=status,resolution_type,shipments(status,completed_at)
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("d8 is closed for the seller and s8 is completed", function () {
    expect(res.getStatus()).to.equal(200);
    const [row] = res.getBody();
    expect(res.getBody().length).to.equal(1);
    expect(row.status).to.equal("resolved");
    expect(row.resolution_type).to.equal("seller_wins_timeout");
    expect(row.shipments.status).to.equal("completed");
    expect(row.shipments.completed_at).to.not.equal(null);
  });
}

docs {
  The dispute is resolved, then the shipment completes and records when.
}
