meta {
  name: fees-setup-job
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_enqueue_stripe_fee_reconciliation_job
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  }
}

body:json {
  {
    "p_order_id": "{{releaseOrderId}}",
    "p_stripe_payment_intent_id": "{{releaseIntentId}}"
  }
}

tests {
  test("the service role adds a due fee job for the order with the real charge", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.equal(true);
  });
}

docs {
  Queues one due job, through the same RPC stripe-webhooks uses, on the order of
  release-order-from-real-charge, whose stripe_charge_id is a real sandbox charge.
}
