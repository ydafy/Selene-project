meta {
  name: fees-order-row
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/rest/v1/orders?id=eq.{{releaseOrderId}}&select=actual_stripe_fee_cents,stripe_fee_reconciled_at
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  }
}

tests {
  test("the order holds the fee of the charge's balance transaction", function () {
    expect(res.getStatus()).to.equal(200);
    const order = res.getBody()[0];
    expect(order.actual_stripe_fee_cents).to.equal(Number(bru.getVar("releaseChargeFee")));
    expect(order.actual_stripe_fee_cents).to.be.above(0);
    expect(Number.isNaN(Date.parse(order.stripe_fee_reconciled_at))).to.equal(false);
  });
}

docs {
  The job itself lives in schema internal; fees-reconcile already proved it succeeded.
  releaseChargeFee is the fee Stripe reported on the charge's balance transaction when
  release-order-from-real-charge created it.
}
