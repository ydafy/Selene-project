meta {
  name: overdue-refund-payout-pending
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/functions/v1/refund-overdue-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  } else {
    req.setBody({ shipment_id: bru.getVar("overduePendingShipmentId") });
  }
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 202) bru.setVar("overduePendingRefundId", res.getBody().refund_id);
}

tests {
  test("a refund Stripe has not settled answers 202 pending", function () {
    expect(res.getStatus()).to.equal(202);
    const body = res.getBody();
    expect(body).to.deep.equal({
      status: "pending",
      shipment_id: bru.getVar("overduePendingShipmentId"),
      refund_id: body.refund_id,
      amount_cents: 251000,
    });
    expect(body.refund_id).to.match(/^re_/);
  });
}

docs {
  pm_card_pendingRefund: Stripe creates the refund as pending, so the function records it and
  leaves the shipment completed; overdue-refund-state-webhook waits for refund.updated.
}
