meta {
  name: overdue-refund-state-webhook
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{overduePendingShipmentId}}&select=status,orders(status,cancellation_loss_cents,actual_stripe_fee_cents)
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  } else {
    const key = bru.getEnvVar("secretKey");
    const rest = async (path) =>
      (await bru.sendRequest({
        method: "GET",
        url: bru.getEnvVar("baseUrl") + "/rest/v1/" + path,
        headers: { apikey: key, Authorization: "Bearer " + key },
      })).data;
    const shipmentId = bru.getVar("overduePendingShipmentId");
    let status = null;
    for (let attempt = 0; attempt < 60 && status !== "refunded"; attempt += 1) {
      if (attempt > 0) await bru.sleep(3000);
      status = (await rest("shipments?id=eq." + shipmentId + "&select=status"))[0].status;
    }
    bru.setVar("overduePendingNotices", JSON.stringify(
      await rest("notifications?user_id=eq." + bru.getVar("sandboxBuyerId") + "&source_event_key=like.shipment.refund*" + shipmentId + "*&select=event_kind"),
    ));
  }
}

tests {
  test("refund.updated completed the overdue refund: shipment and order refunded", function () {
    expect(res.getStatus()).to.equal(200);
    const shipment = res.getBody()[0];
    expect(shipment.status).to.equal("refunded");
    expect(shipment.orders.status).to.equal("refunded");
    expect(shipment.orders.cancellation_loss_cents).to.equal(shipment.orders.actual_stripe_fee_cents);
  });

  test("the buyer gets one refund notice", function () {
    expect(JSON.parse(bru.getVar("overduePendingNotices"))).to.deep.equal([{ event_kind: "shipment.refunded" }]);
  });
}

docs {
  Waits up to about 3 minutes for `bun run stripe:listen` to deliver refund.updated with status
  succeeded; stripe-webhooks then runs fn_apply_shipment_cancellation_refund_event, which
  completes the admin_overdue_payout source through fn_complete_overdue_payout_refund.
}
