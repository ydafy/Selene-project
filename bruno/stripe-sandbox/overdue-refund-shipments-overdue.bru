meta {
  name: overdue-refund-shipments-overdue
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=in.({{overdueCardShipmentId}},{{overduePendingShipmentId}})
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  } else {
    const completedAt = new Date(Date.now() - 40 * 24 * 3600 * 1000).toISOString();
    req.setBody({ status: "completed", delivered_at: completedAt, completed_at: completedAt });
  }
}

body:json {
  {}
}

tests {
  test("both shipments were completed 40 days ago and never transferred", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map((s) => [s.status, s.stripe_transfer_id])).to.deep.equal([
      ["completed", null],
      ["completed", null],
    ]);
  });
}

docs {
  Service-role precondition: delivery, the dispute window and 40 days of held payout are out of
  scope; with the rejected seller both shipments are overdue (S1).
}
