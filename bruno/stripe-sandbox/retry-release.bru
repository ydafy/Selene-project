meta {
  name: retry-release
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/functions/v1/release-connect-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  }
}

body:json {
  { "retryRunId": "{{failedRunId}}" }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().success === true) {
    bru.setVar("retryRunId", res.getBody().runId);
    bru.setVar("retryPayoutId", res.getBody().stripePayoutId);
  }
}

tests {
  test("the retry reads the failed payout on the connected account and pays out again", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.deep.equal({
      success: true,
      runId: body.runId,
      stripePayoutId: body.stripePayoutId,
      status: "pending_reconciliation",
      amount: 210600,
    });
    expect(body.runId).to.not.equal(bru.getVar("failedRunId"));
    expect(body.stripePayoutId).to.match(/^po_/);
    expect(body.stripePayoutId).to.not.equal(bru.getVar("failedPayoutId"));
  });
}

docs {
  The retry branch calls stripe.payouts.retrieve(<failed payout>, {}, { stripeAccount })
  (release-connect-payout/index.ts:370) and requires a failed payout of the same amount in
  MXN with a failure balance transaction (release-connect-payout.ts:860-892). The transfer
  is not repeated (the shipment keeps its transfer id); the returned funds pay a new payout
  under a child run (lines 1235-1241).
}
