meta {
  name: overdue-refund-payout-again
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/functions/v1/refund-overdue-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  } else {
    req.setBody({ shipment_id: bru.getVar("overdueCardShipmentId") });
  }
}

body:json {
  {}
}

script:post-response {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") === "1" &&
    bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    let refunds;
    try {
      refunds = await bru.sendRequest({
        method: "GET",
        url: "https://api.stripe.com/v1/refunds?payment_intent=" + bru.getVar("overdueCardIntentId"),
        headers: { Authorization: "Bearer " + bru.getProcessEnv("STRIPE_SECRET_KEY") },
      });
    } catch (error) {
      refunds = error.response;
    }
    bru.setVar("overdueCardRefundCount", refunds && refunds.status === 200 ? refunds.data.data.length : -1);
  }
}

tests {
  test("a second request for a refunded shipment is refused and Stripe keeps one refund", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody()).to.deep.equal({ error: "SHIPMENT_ALREADY_REFUNDED" });
    expect(bru.getVar("overdueCardRefundCount")).to.equal(1);
  });
}

docs {
  Idempotency: the claim raises SHIPMENT_ALREADY_REFUNDED for a refunded shipment before any
  eligibility check, so no second refund reaches Stripe.
}
