meta {
  name: connect-account-onboarding-link
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/functions/v1/create-connect-account
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{buyerToken}}
}

script:pre-request {
  if (bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1") {
    bru.runner.skipRequest();
  }
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("sandboxOnboardingUrl", res.getBody().url);
    console.log("onboarding url: " + res.getBody().url);
  }
}

tests {
  test("a user without an account gets an HTTPS hosted onboarding link for a sandbox v2 account", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Object.keys(body)).to.deep.equal(["url"]);
    expect(body.url.startsWith("https://")).to.equal(true);
  });
}

docs {
  Creates (or reuses) the seeded buyer's Stripe v2 recipient account (a user who has no account yet; the seeded seller has a fake acct_local_ id) in the sandbox and mints
  an Account Link. Open the logged URL to see which questions the hosted form asks (#550).
  Needs STRIPE_SECRET_KEY and an HTTPS onboarding bridge or return/refresh URL in
  supabase/functions/.env; no webhook, so stripe:listen is not needed. Run after
  auth/login-buyer.
}
