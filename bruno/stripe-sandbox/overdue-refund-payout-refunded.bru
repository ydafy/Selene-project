meta {
  name: overdue-refund-payout-refunded
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/functions/v1/refund-overdue-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  if (
    bru.getProcessEnv("BRUNO_STRIPE_SANDBOX") !== "1" ||
    !bru.getProcessEnv("BRUNO_STRIPE_TEST_ACCOUNT_ID") ||
    !bru.getProcessEnv("STRIPE_SECRET_KEY")
  ) {
    bru.runner.skipRequest();
  } else {
    req.setBody({ shipment_id: bru.getVar("overdueCardShipmentId"), amount_cents: 1 });
  }
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("overdueCardRefundId", res.getBody().refund_id);
}

tests {
  test("the admin refunds the buyer what they paid for the shipment, computed on the server", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.deep.equal({
      status: "refunded",
      shipment_id: bru.getVar("overdueCardShipmentId"),
      refund_id: body.refund_id,
      amount_cents: 251000,
    });
    expect(body.refund_id).to.match(/^re_/);
  });
}

docs {
  refund-overdue-payout on the sandbox (S3): live rejected.* check, card-only charge, claim,
  frozen request, Stripe refund, record, completion. The body's amount_cents is ignored: the
  refund is the item subtotal 240000 plus the shipment's whole Seguro share 11000, the whole
  charge of this one-shipment order.
}
