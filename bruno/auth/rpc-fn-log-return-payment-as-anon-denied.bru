meta {
  name: rpc-fn-log-return-payment-as-anon-denied
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_log_return_payment
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_dispute_id": "00000000-0000-4000-8000-0000000000ff",
    "p_stripe_id": "pi_denied",
    "p_amount": 1
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_log_return_payment");
  });
}

docs {
  EXECUTE on fn_log_return_payment is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
