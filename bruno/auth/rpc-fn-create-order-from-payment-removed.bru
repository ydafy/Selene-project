tests {
  test("the dropped function is not found, even for the service role", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().code).to.equal("PGRST202");
  });
}

docs {
  fn_create_order_from_payment was dropped with the non-Connect order path (expo-push-notifications T6a). Every order is created by fn_create_shipments_from_single_payment.
  The ids are placeholders: no function runs, so nothing changes.
}
