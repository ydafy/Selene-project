meta {
  name: signup-deleted-email-prefix-derived
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/auth/v1/signup
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

script:pre-request {
  bru.setVar("derivedSignupEmail", "deleted_" + Date.now() + "@selene.local");
}

body:json {
  {
    "gotrue_meta_security": { "captcha_token": "{{captchaToken}}" },
    "email": "{{derivedSignupEmail}}",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("derivedSignupUserId", res.getBody().id);
  }
}

tests {
  test("an email starting with deleted_ still signs the user up", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. The next request reads the derived username.
}
