meta {
  name: login-buyer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  {
    "email": "buyer@selene.local",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("buyerToken", res.getBody().access_token);
  }
}

tests {
  test("logs in the seeded buyer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });
}

docs {
  Signs in the seeded buyer (supabase/seed.sql) and stores the access token in the
  `buyerToken` runtime variable for the requests that follow. Proves local Auth is up
  and the seed was loaded.
}
