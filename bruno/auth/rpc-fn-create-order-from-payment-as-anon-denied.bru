meta {
  name: rpc-fn-create-order-from-payment-as-anon-denied
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_create_order_from_payment
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_buyer_id": "00000000-0000-4000-8000-0000000000ff",
    "p_stripe_intent_id": "pi_denied",
    "p_total_amount": 1,
    "p_service_fee": 0,
    "p_address_id": "00000000-0000-4000-8000-0000000000ff",
    "p_product_ids": [
      "00000000-0000-4000-8000-0000000000ff"
    ]
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_create_order_from_payment");
  });
}

docs {
  EXECUTE on fn_create_order_from_payment is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
