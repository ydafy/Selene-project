meta {
  name: system-settings-buyer-lease-column-denied
  type: http
  seq: 82
}

get {
  url: {{baseUrl}}/rest/v1/system_settings?id=eq.1&select=listing_quote_reference_destination,auto_cancel_orders_lease_id
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("a signed-in user cannot read the Envia reference address or a cron lease", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). Clients hold SELECT only on the
  columns the app reads (#305, #309).
}
