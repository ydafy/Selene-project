meta {
  name: rpc-fn-release-shipment-funds-as-anon-denied
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_release_shipment_funds
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_shipment_id": "00000000-0000-4000-8000-0000000000ff"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_release_shipment_funds");
  });
}

docs {
  EXECUTE on fn_release_shipment_funds is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
