meta {
  name: rpc-fn-resolve-dispute-to-seller-as-admin-as-anon-denied
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_resolve_dispute_to_seller_as_admin
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_dispute_id": "00000000-0000-4000-8000-0000000000ff",
    "p_admin_note": "denied",
    "p_admin_id": "00000000-0000-4000-8000-000000000001"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_resolve_dispute_to_seller_as_admin");
  });
}

docs {
  EXECUTE on fn_resolve_dispute_to_seller_as_admin is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
