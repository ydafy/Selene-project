meta {
  name: close-account-as-anon-denied
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_close_account
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_user_id": "00000000-0000-4000-8000-0000000000ff"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Proves EXECUTE on fn_close_account is revoked from `anon`. The uuid belongs to no
  user, so even a regression would close nothing.
}
