  {}
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_list_shipment_label_reconciliations");
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). The list of shipments stuck in label generation is service-only.
