meta {
  name: username-availability-free-anon
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/rest/v1/profiles?select=id&username=eq.nobody_has_this_name&limit=1
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

tests {
  test("an unused username is reported as available to an anonymous caller", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(0);
  });
}

docs {
  The registration form reads `profiles` as anon (policy `profiles_public_read`)
  before calling signUp to tell whether a typed username is already taken.
}
