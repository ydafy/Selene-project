meta {
  name: rpc-fn-release-listings-as-buyer-denied
  type: http
  seq: 74
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_release_listings
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "p_product_ids": ["00000000-0000-4000-8000-0000000000ba"],
    "p_only_reserved": false,
    "p_only_expired": false
  }
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_release_listings");
  });
}

docs {
  Run after auth/login-buyer (needs `buyerToken`). EXECUTE on fn_release_listings is limited to service_role, so a client cannot call it through the RPC.
  The request is refused before the function runs and changes nothing.
}
