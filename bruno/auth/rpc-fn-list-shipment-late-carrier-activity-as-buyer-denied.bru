meta {
  name: rpc-fn-list-shipment-late-carrier-activity-as-buyer-denied
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_list_shipment_late_carrier_activity
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {}
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_list_shipment_late_carrier_activity");
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). The list of cancellations whose shipment saw carrier activity after the refund started is service-only.
}
