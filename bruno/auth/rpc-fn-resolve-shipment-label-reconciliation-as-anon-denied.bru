meta {
  name: rpc-fn-resolve-shipment-label-reconciliation-as-anon-denied
  type: http
  seq: 68
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_resolve_shipment_label_reconciliation
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_shipment_id": "00000000-0000-4000-8000-0000000000aa",
    "p_actor_id": "00000000-0000-4000-8000-000000000001",
    "p_resolution": "no_label",
    "p_note": "denied"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_resolve_shipment_label_reconciliation");
  });
}

docs {
  Resolving a shipment stuck in label generation is service-only. The shipment id does not exist: the call is refused before anything runs.
}
