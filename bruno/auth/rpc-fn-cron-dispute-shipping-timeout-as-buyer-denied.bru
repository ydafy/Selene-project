meta {
  name: rpc-fn-cron-dispute-shipping-timeout-as-buyer-denied
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_cron_dispute_shipping_timeout
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {}
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_cron_dispute_shipping_timeout");
  });
}

docs {
  Run after auth/login-buyer (needs `buyerToken`). EXECUTE on fn_cron_dispute_shipping_timeout is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
