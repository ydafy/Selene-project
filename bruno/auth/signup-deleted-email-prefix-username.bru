meta {
  name: signup-deleted-email-prefix-username
  type: http
  seq: 72
}

get {
  url: {{baseUrl}}/rest/v1/profiles?id=eq.{{derivedSignupUserId}}&select=username
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the derived username does not start with the reserved deleted_ prefix", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].username.toLowerCase().startsWith("deleted_")).to.equal(false);
    expect(res.getBody()[0].username.startsWith("user_deleted_")).to.equal(true);
  });
}

docs {
  fn_generate_profile_username puts "user_" in front of a derived base that starts with deleted_.
}
