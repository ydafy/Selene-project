meta {
  name: signup-profile-row
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/rest/v1/profiles?id=eq.{{signupUserId}}&select=id,username,is_verified_seller
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the new user has a public profile", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].username).to.be.a("string");
    expect(res.getBody()[0].is_verified_seller).to.equal(false);
  });
}

docs {
  Profile written by fn_on_auth_user_created.
}
