tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_list_shipment_late_carrier_activity");
  });
}

docs {
  The list of cancellations whose shipment saw carrier activity after the refund started is service-only.
}
