meta {
  name: rpc-fn-record-dispute-refund-as-anon-denied
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_dispute_refund
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_dispute_id": "00000000-0000-4000-8000-0000000000fe",
    "p_stripe_refund_id": "re_bruno_role_check"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_record_dispute_refund");
  });
}

docs {
  EXECUTE on fn_record_dispute_refund is limited to service_role, so a client cannot call it through the RPC.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
