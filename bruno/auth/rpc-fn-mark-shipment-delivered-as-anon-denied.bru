meta {
  name: rpc-fn-mark-shipment-delivered-as-anon-denied
  type: http
  seq: 56
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_mark_shipment_delivered
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_shipment_id": "00000000-0000-4000-8000-0000000000ff"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_mark_shipment_delivered");
  });
}

docs {
  EXECUTE on fn_mark_shipment_delivered is limited to service_role.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
