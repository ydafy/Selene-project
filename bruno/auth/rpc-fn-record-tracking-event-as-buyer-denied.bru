meta {
  name: rpc-fn-record-tracking-event-as-buyer-denied
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_tracking_event
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "p_shipment_id": "00000000-0000-4000-8000-0000000000ff",
    "p_dispute_id": null,
    "p_event_type": "in_transit",
    "p_event_at": "2026-10-24T10:00:00Z",
    "p_raw_status": "denied",
    "p_location": null,
    "p_status_description": null,
    "p_carrier_name": null,
    "p_webhook_delivery_id": null,
    "p_polling_run_id": null,
    "p_transition": "shipped"
  }
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_record_tracking_event");
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). EXECUTE on fn_record_tracking_event is limited to service_role.
  The ids are placeholders: the request is refused before the function runs and changes nothing.
}
