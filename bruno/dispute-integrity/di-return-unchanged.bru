meta {
  name: di-return-unchanged
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/rest/v1/disputes?id=eq.{{diDispReturn}}&select=status,resolution_type,shipments(status)
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("the dispute still waits for the return and the shipment is still delivered", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ status: "waiting_return", resolution_type: null, shipments: { status: "delivered" } }]);
  });
}
