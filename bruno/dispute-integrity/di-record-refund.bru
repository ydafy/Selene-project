meta {
  name: di-record-refund
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_dispute_refund
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_dispute_id": "{{diDispReturn}}",
    "p_stripe_refund_id": "re_bruno_di_return"
  }
}

tests {
  test("the refund is recorded", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, error_code: null }]);
  });
}

docs {
  Local stack only; the refund id is fake. Service role only.
}
