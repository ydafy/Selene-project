meta {
  name: register-invalid-platform-rejected
  type: http
  seq: 110
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_register_push_token
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-token-0001]", "p_platform": "web" }
}

tests {
  test("a platform other than ios or android is rejected", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("INVALID_PUSH_PLATFORM");
  });
}

docs {
  Valid token, unsupported platform.
}
