meta {
  name: milestones-record-in-transit
  type: http
  seq: 179
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_tracking_event
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  bru.setVar("msEventAt", "2026-10-30T10:00:00Z");
}

body:json {
  {
    "p_shipment_id": "{{msTrackShipmentId}}",
    "p_dispute_id": null,
    "p_event_type": "in_transit",
    "p_event_at": "{{msEventAt}}",
    "p_raw_status": "bruno-milestones",
    "p_location": null,
    "p_status_description": null,
    "p_carrier_name": null,
    "p_webhook_delivery_id": null,
    "p_polling_run_id": null,
    "p_transition": "shipped"
  }
}

tests {
  test("S4: the first in_transit scan moves preparing to shipped", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().inserted).to.equal(true);
    expect(res.getBody().shipment_status).to.equal("shipped");
  });
}

docs {
  Service role. Writes the shipment.in_transit buyer notice. The p_event_at is stored in msEventAt so the next request replays the identical event.
}
