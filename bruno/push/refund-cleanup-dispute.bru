meta {
  name: refund-cleanup-dispute
  type: http
  seq: 253
}

delete {
  url: {{baseUrl}}/rest/v1/disputes?id=eq.{{rfDisputeId}}
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

tests {
  test("the dispute is removed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
  });
}

docs {
  Cleanup. The dispute goes before its shipment and order.
}
