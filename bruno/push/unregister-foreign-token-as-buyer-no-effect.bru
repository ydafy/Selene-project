meta {
  name: unregister-foreign-token-as-buyer-no-effect
  type: http
  seq: 107
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_unregister_push_token
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-token-0001]" }
}

tests {
  test("a buyer unregistering a token it does not own gets no error", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  The row belongs to the seller, so nothing is deleted.
}
