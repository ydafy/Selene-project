meta {
  name: funds-complete-as-service-role
  type: http
  seq: 208
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_complete_shipment_transfer
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_run_id": "{{fdRunId}}",
    "p_shipment_id": "{{fdShipmentId}}",
    "p_expected_stage_version": {{fdStageVersion}},
    "p_transfer_token": "{{fdTransferToken}}",
    "p_stripe_transfer_id": "{{fdTransferId}}"
  }
}

tests {
  test("S4: the first completion records the transfer and returns true", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.equal(true);
  });
}

docs {
  Service role. First call with the run's stage version, the mapping's token and a new Stripe transfer id: the only call that writes the seller notice.
}
