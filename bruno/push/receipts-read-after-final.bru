meta {
  name: receipts-read-after-final
  type: http
  seq: 158
}

get {
  url: {{baseUrl}}/rest/v1/push_deliveries?select=status,receipt_status,receipt_error,receipt_checked_at&id=eq.{{pushDeliveryId}}
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the receipt stays missing", function () {
    const rows = res.getBody();
    expect(rows).to.have.length(1);
    expect(rows[0].receipt_status).to.equal("missing");
    expect(rows[0].receipt_error).to.equal(null);
  });
}

docs {
  The ignored ok receipt left it unchanged.
}
