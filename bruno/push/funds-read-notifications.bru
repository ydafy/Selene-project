meta {
  name: funds-read-notifications
  type: http
  seq: 210
}

get {
  url: {{baseUrl}}/rest/v1/notifications?select=id,user_id,event_kind,source_event_key,event_payload,type,title,message,action_path,read&source_event_key=eq.shipment.funds_released:{{fdShipmentId}}
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().length === 1) {
    bru.setVar("fdNoticeId", res.getBody()[0].id);
  }
}

tests {
  test("S4: exactly one notice for the key, after the completion and its replay", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
  });

  test("S4: the notice is a success for the seller with the stored Spanish copy", function () {
    const row = res.getBody()[0];
    expect(row.user_id).to.equal(bru.getVar("fdSellerId"));
    expect(row.event_kind).to.equal("shipment.funds_released");
    expect(row.type).to.equal("success");
    expect(row.read).to.equal(false);
    expect(row.title).to.equal("Liberamos el pago de tu venta");
    expect(row.message).to.equal("Enviamos $1,234.56 MXN a tu cuenta de vendedor. El depósito a tu banco puede tardar unos días hábiles.");
    expect(row.action_path).to.equal("/profile/orders/" + bru.getVar("fdOrderId"));
  });

  test("S4: the payload carries the order, the shipment, the amount in cents and the seller role", function () {
    const payload = res.getBody()[0].event_payload;
    expect(payload.order_id).to.equal(bru.getVar("fdOrderId"));
    expect(payload.shipment_id).to.equal(bru.getVar("fdShipmentId"));
    expect(payload.amount_cents).to.equal(123456);
    expect(payload.currency).to.equal("mxn");
    expect(payload.recipient_role).to.equal("seller");
  });
}

docs {
  Service-role read by source_event_key. Stores the id in fdNoticeId.
}
