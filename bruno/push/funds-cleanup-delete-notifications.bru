meta {
  name: funds-cleanup-delete-notifications
  type: http
  seq: 215
}

delete {
  url: {{baseUrl}}/rest/v1/notifications?user_id=eq.{{fdSellerId}}
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

tests {
  test("the funds-released notice is removed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
  });
}

docs {
  Cleanup. Deleting a notification cascades to its deliveries, so dispatch-push-run never claims them.
}
