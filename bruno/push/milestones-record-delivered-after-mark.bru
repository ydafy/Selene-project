meta {
  name: milestones-record-delivered-after-mark
  type: http
  seq: 183
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_tracking_event
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_shipment_id": "{{msMarkShipmentId}}",
    "p_dispute_id": null,
    "p_event_type": "delivered",
    "p_event_at": "{{msDeliveredAt}}",
    "p_raw_status": "bruno-milestones",
    "p_location": null,
    "p_status_description": null,
    "p_carrier_name": null,
    "p_webhook_delivery_id": null,
    "p_polling_run_id": null,
    "p_transition": "delivered"
  }
}

tests {
  test("S4: a later carrier delivered scan is recorded but the shipment stays delivered", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().inserted).to.equal(true);
    expect(res.getBody().shipment_status).to.equal("delivered");
  });
}

docs {
  The shipment was already delivered by milestones-mark-delivered, so this scan moves nothing and writes no second notice. The notice count is asserted in milestones-read-notifications.
}
