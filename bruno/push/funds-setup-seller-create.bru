meta {
  name: funds-setup-seller-create
  type: http
  seq: 197
}

post {
  url: {{baseUrl}}/auth/v1/admin/users
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  bru.setVar("fdSellerEmail", "bruno-funds-seller-" + Date.now() + "@selene.local");
}

body:json {
  {
    "email": "{{fdSellerEmail}}",
    "password": "password123",
    "email_confirm": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("fdSellerId", res.getBody().id);
  }
}

tests {
  test("creates a confirmed throwaway seller for the funds-released notice", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. Each run makes its own seller, so the folder is repeatable. Stores fdSellerEmail and fdSellerId.
}
