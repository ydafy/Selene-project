meta {
  name: funds-setup-register-token
  type: http
  seq: 199
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_register_push_token
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{fdSellerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-funds-0001]", "p_platform": "android" }
}

tests {
  test("the throwaway seller registers a push token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Gives the seller one active token, so the funds-released notice fans out to one pending delivery. The folder removes it at the end.
}
