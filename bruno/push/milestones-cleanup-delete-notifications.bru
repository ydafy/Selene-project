meta {
  name: milestones-cleanup-delete-notifications
  type: http
  seq: 191
}

delete {
  url: {{baseUrl}}/rest/v1/notifications?user_id=eq.{{msBuyerId}}
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

tests {
  test("the three milestone notices are removed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(3);
  });
}

docs {
  Cleanup. Deleting a notification cascades to its deliveries, so dispatch-push-run never claims them.
}
