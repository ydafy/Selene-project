meta {
  name: funds-setup-order
  type: http
  seq: 201
}

post {
  url: {{baseUrl}}/rest/v1/orders
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

body:json {
  {
    "buyer_id": "{{fdBuyerId}}",
    "total_amount_cents": 10000,
    "shipping_address": {}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("fdOrderId", res.getBody()[0].id);
  }
}

tests {
  test("inserts an order owned by the throwaway buyer", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()[0].buyer_id).to.equal(bru.getVar("fdBuyerId"));
  });
}

docs {
  Local stack only. Service-role insert; only buyer_id, total_amount_cents and shipping_address are required.
}
