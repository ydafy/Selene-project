meta {
  name: milestones-notify-as-anon-denied
  type: http
  seq: 188
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_notify_shipment_milestone
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  { "p_shipment_id": "{{msTrackShipmentId}}", "p_event_kind": "shipment.delivered" }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_notify_shipment_milestone");
  });
}

docs {
  fn_notify_shipment_milestone has no client grant: only the SECURITY DEFINER producers call it.
}
