meta {
  name: outbox-record-results-as-buyer-denied
  type: http
  seq: 134
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_push_results
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  { "p_results": [{ "id": "{{pushDeliveryId}}", "claim_token": "00000000-0000-4000-8000-0000000000aa", "outcome": "failed", "error": "denied" }] }
}

tests {
  test("the caller cannot record results", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_record_push_results");
  });
}

docs {
  EXECUTE is granted to service_role only.
}
