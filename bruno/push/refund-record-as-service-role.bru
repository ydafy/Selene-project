meta {
  name: refund-record-as-service-role
  type: http
  seq: 241
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_record_dispute_refund
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

body:json {
  {
    "p_dispute_id": "{{rfDisputeId}}",
    "p_stripe_refund_id": "re_bruno_refund_notice"
  }
}

tests {
  test("S4: the service role records the refund", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, error_code: null }]);
  });
}

docs {
  Service role, the way resolve-dispute-refund calls it after the Stripe refund was created.
}
