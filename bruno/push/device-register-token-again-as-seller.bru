  Authorization: Bearer {{sellerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-token-0003]", "p_platform": "android" }
}

tests {
  test("the seller registers the device token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

