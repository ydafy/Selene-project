meta {
  name: table-select-as-buyer-denied
  type: http
  seq: 113
}

get {
  url: {{baseUrl}}/rest/v1/push_tokens?select=*
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("an authenticated user has no table access", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Clients reach push_tokens only through the RPCs.
}
