meta {
  name: outbox-register-token-as-seller
  type: http
  seq: 122
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_register_push_token
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-token-0002]", "p_platform": "android" }
}

tests {
  test("the seller registers a token for the outbox checks", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Run after auth/login-seller. The folder deletes the token at the end.
}
