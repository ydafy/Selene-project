meta {
  name: funds-setup-seller-login
  type: http
  seq: 198
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
}

body:json {
  {
    "gotrue_meta_security": { "captcha_token": "{{captchaToken}}" },
    "email": "{{fdSellerEmail}}",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("fdSellerToken", res.getBody().access_token);
  }
}

tests {
  test("signs in the throwaway seller", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });
}

docs {
  Stores the access token in the fdSellerToken runtime variable.
}
