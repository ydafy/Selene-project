meta {
  name: refund-read-policy
  type: http
  seq: 247
}

get {
  url: {{baseUrl}}/rest/v1/push_event_policy?select=event_kind,recipient_role,channel&event_kind=eq.shipment.refunded
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("S4: refunds push to the buyer on the orders channel", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ event_kind: "shipment.refunded", recipient_role: "buyer", channel: "orders" }]);
  });
}

docs {
  Service-role read of push_event_policy.
}
