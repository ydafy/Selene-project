meta {
  name: deadline-notify-as-anon-denied
  type: http
  seq: 262
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_notify_label_deadline_reminders
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {}
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_notify_label_deadline_reminders");
  });
}

docs {
  The function is granted to service_role only; auto-cancel-orders calls it on every hourly run.
}
