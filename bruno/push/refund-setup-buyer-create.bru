meta {
  name: refund-setup-buyer-create
  type: http
  seq: 230
}

post {
  url: {{baseUrl}}/auth/v1/admin/users
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  bru.setVar("rfBuyerEmail", "bruno-refund-buyer-" + Date.now() + "@selene.local");
}

body:json {
  {
    "email": "{{rfBuyerEmail}}",
    "password": "password123",
    "email_confirm": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("rfBuyerId", res.getBody().id);
  }
}

tests {
  test("creates a confirmed throwaway buyer who will be refunded", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. Each run makes its own buyer, so the folder is repeatable. Stores rfBuyerEmail and rfBuyerId.
}
