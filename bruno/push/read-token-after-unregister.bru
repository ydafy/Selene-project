meta {
  name: read-token-after-unregister
  type: http
  seq: 120
}

get {
  url: {{baseUrl}}/rest/v1/push_tokens?select=user_id,platform,disabled_at&token=eq.ExponentPushToken%5Bbruno-push-token-0001%5D
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("the token is gone", function () {
    expect(res.getBody()).to.have.length(0);
  });
}

docs {
