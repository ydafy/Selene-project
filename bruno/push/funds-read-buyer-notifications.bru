meta {
  name: funds-read-buyer-notifications
  type: http
  seq: 211
}

get {
  url: {{baseUrl}}/rest/v1/notifications?select=id&user_id=eq.{{fdBuyerId}}
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("S4: the buyer of the order got no notice", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(0);
  });
}

docs {
  Service-role read of every notification of the throwaway buyer.
}
