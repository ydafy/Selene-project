meta {
  name: milestones-setup-buyer-create
  type: http
  seq: 174
}

post {
  url: {{baseUrl}}/auth/v1/admin/users
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  bru.setVar("msBuyerEmail", "bruno-milestones-" + Date.now() + "@selene.local");
}

body:json {
  {
    "email": "{{msBuyerEmail}}",
    "password": "password123",
    "email_confirm": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("msBuyerId", res.getBody().id);
  }
}

tests {
  test("creates a confirmed throwaway buyer for the milestone notices", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. Each run makes its own buyer, so the folder is repeatable. Stores msBuyerId.
}
