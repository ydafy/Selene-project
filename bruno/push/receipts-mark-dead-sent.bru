meta {
  name: receipts-mark-dead-sent
  type: http
  seq: 164
}

patch {
  url: {{baseUrl}}/rest/v1/push_deliveries?notification_id=eq.{{pushDeadNotificationId}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  { "status": "sent", "attempts": 1, "expo_ticket_id": "bruno-ticket-3", "sent_at": "{{pushSentAt}}" }
}

script:pre-request {
  bru.setVar("pushSentAt", new Date().toISOString());
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("pushDeadDeliveryId", res.getBody()[0].id);
  }
}

tests {
  test("the fixture row is updated", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
  });
}

docs {
  Stands in for a send after the last registration of the token.
}
