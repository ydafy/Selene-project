meta {
  name: deadline-cleanup-shipment
  type: http
  seq: 271
}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{dlShipmentId}}
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "cancelled"
  }
}

tests {
  test("the shipment is closed so no cron run selects it", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
    expect(res.getBody()[0].status).to.equal("cancelled");
  });
}
