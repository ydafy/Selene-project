meta {
  name: table-select-as-anon-denied
  type: http
  seq: 114
}

get {
  url: {{baseUrl}}/rest/v1/push_tokens?select=*
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
}

tests {
  test("an anonymous caller has no table access", function () {
    expect(res.getStatus()).to.be.equal(401);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Clients reach push_tokens only through the RPCs.
}
