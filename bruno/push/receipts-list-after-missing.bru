meta {
  name: receipts-list-after-missing
  type: http
  seq: 154
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_list_push_receipts_due
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  { "p_limit": 1000 }
}

tests {
  test("the sent ticket is not listed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map((r) => r.delivery_id)).to.not.include(bru.getVar("pushDeliveryId"));
  });
}

docs {
  A ticket checked less than 15 minutes ago waits for its next check.
}
