meta {
  name: receipts-purge-push-deliveries-as-anon-denied
  type: http
  seq: 143
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_purge_push_deliveries
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  { "p_limit": 10 }
}

tests {
  test("the caller cannot run fn_purge_push_deliveries", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_purge_push_deliveries");
  });
}

docs {
  EXECUTE is granted to service_role only.
}
