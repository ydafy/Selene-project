meta {
  name: outbox-cleanup-delete-notifications
  type: http
  seq: 171
}

delete {
  url: {{baseUrl}}/rest/v1/notifications?source_event_key=in.(bruno-push-outbox:buyer,bruno-push-outbox:seller,bruno-push-receipts:keep,bruno-push-receipts:dead)
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

tests {
  test("every fixture notification is removed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(4);
  });
}

docs {
  Cleanup. Deleting a notification cascades to its deliveries.
}
