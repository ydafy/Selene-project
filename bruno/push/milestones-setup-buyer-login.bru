meta {
  name: milestones-setup-buyer-login
  type: http
  seq: 175
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  {
    "gotrue_meta_security": { "captcha_token": "{{captchaToken}}" },
    "email": "{{msBuyerEmail}}",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("msBuyerToken", res.getBody().access_token);
  }
}

tests {
  test("signs in the throwaway buyer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });
}

docs {
  Stores the access token in the msBuyerToken runtime variable.
}
