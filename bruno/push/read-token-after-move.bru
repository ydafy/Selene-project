meta {
  name: read-token-after-move
  type: http
  seq: 106
}

get {
  url: {{baseUrl}}/rest/v1/push_tokens?select=user_id,platform,disabled_at&token=eq.ExponentPushToken%5Bbruno-push-token-0001%5D
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("one row remains and it belongs to the seller on ios", function () {
    const rows = res.getBody();
    expect(rows).to.have.length(1);
    expect(rows[0].user_id).to.equal(bru.getVar("pushSellerId"));
    expect(rows[0].platform).to.equal("ios");
  });
}

docs {
  Service-role read after the move.
}
