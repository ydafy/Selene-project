meta {
  name: refund-read-notifications
  type: http
  seq: 244
}

get {
  url: {{baseUrl}}/rest/v1/notifications?select=id,user_id,event_kind,source_event_key,event_payload,type,title,message,action_path,read&source_event_key=eq.shipment.refunded:{{rfShipmentId}}
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().length === 1) {
    bru.setVar("rfNoticeId", res.getBody()[0].id);
  }
}

tests {
  test("S4: exactly one notice for the key, after the record and its replay", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
  });

  test("S4: the notice is a success for the buyer with the stored Spanish copy", function () {
    const row = res.getBody()[0];
    expect(row.user_id).to.equal(bru.getVar("rfBuyerId"));
    expect(row.event_kind).to.equal("shipment.refunded");
    expect(row.type).to.equal("success");
    expect(row.read).to.equal(false);
    expect(row.title).to.equal("Te devolvimos tu dinero");
    expect(row.message).to.equal("Reembolsamos tu compra a tu método de pago. Puede tardar de 5 a 10 días hábiles en verse en tu estado de cuenta.");
    expect(row.action_path).to.equal("/profile/orders/" + bru.getVar("rfOrderId") + "?shipment_id=" + bru.getVar("rfShipmentId"));
  });

  test("S4: the payload carries the shipment, the order, the dispute and the buyer role", function () {
    const payload = res.getBody()[0].event_payload;
    expect(payload.shipment_id).to.equal(bru.getVar("rfShipmentId"));
    expect(payload.order_id).to.equal(bru.getVar("rfOrderId"));
    expect(payload.dispute_id).to.equal(bru.getVar("rfDisputeId"));
    expect(payload.recipient_role).to.equal("buyer");
  });
}

docs {
  Service-role read by source_event_key. Stores the id in rfNoticeId.
}
