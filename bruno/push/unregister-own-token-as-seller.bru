meta {
  name: unregister-own-token-as-seller
  type: http
  seq: 119
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_unregister_push_token
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-push-token-0001]" }
}

tests {
  test("the owner removes its token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Cleanup of the folder fixture.
}
