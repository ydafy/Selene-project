meta {
  name: milestones-read-notifications
  type: http
  seq: 185
}

get {
  url: {{baseUrl}}/rest/v1/notifications?select=id,user_id,event_kind,source_event_key,event_payload,type,title,message,action_path,read&source_event_key=in.(shipment.in_transit:{{msTrackShipmentId}},shipment.delivered:{{msTrackShipmentId}},shipment.in_transit:{{msMarkShipmentId}},shipment.delivered:{{msMarkShipmentId}})&order=source_event_key
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("msNoticeIds", res.getBody().map((r) => r.id).sort().join(","));
  }
}

tests {
  test("S4: exactly three buyer notices, none for the mark shipment's in_transit and none for the seller", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows).to.have.length(3);
    const keys = rows.map((r) => r.source_event_key).sort();
    expect(keys).to.deep.equal(
      [
        "shipment.in_transit:" + bru.getVar("msTrackShipmentId"),
        "shipment.delivered:" + bru.getVar("msTrackShipmentId"),
        "shipment.delivered:" + bru.getVar("msMarkShipmentId"),
      ].sort(),
    );
    rows.forEach((r) => {
      expect(r.user_id).to.equal(bru.getVar("msBuyerId"));
      expect(r.read).to.equal(false);
      expect(r.action_path).to.equal("/profile/orders/" + bru.getVar("msOrderId"));
      expect(r.event_payload.order_id).to.equal(bru.getVar("msOrderId"));
      expect(r.event_payload.recipient_role).to.equal("buyer");
      expect(r.source_event_key).to.equal(r.event_kind + ":" + r.event_payload.shipment_id);
    });
  });

  test("S4: the in_transit notice is an info with the in-transit copy", function () {
    const row = res.getBody().find((r) => r.event_kind === "shipment.in_transit");
    expect(row.event_payload.shipment_id).to.equal(bru.getVar("msTrackShipmentId"));
    expect(row.type).to.equal("info");
    expect(row.title).to.equal("Tu envío va en camino");
    expect(row.message).to.equal("La paquetería ya lleva un envío de tu pedido. Puedes seguirlo desde tu pedido.");
  });

  test("S4: both delivered notices are a success with the delivered copy, one per shipment", function () {
    const rows = res.getBody().filter((r) => r.event_kind === "shipment.delivered");
    expect(rows).to.have.length(2);
    expect(rows.map((r) => r.event_payload.shipment_id).sort()).to.deep.equal(
      [bru.getVar("msTrackShipmentId"), bru.getVar("msMarkShipmentId")].sort(),
    );
    rows.forEach((r) => {
      expect(r.type).to.equal("success");
      expect(r.title).to.equal("Tu envío fue entregado");
      expect(r.message).to.equal("Revisa tus productos. Tienes 48 horas desde la entrega para reportar un problema.");
    });
  });
}

docs {
  Service-role read by source_event_key, after every call above ran. The count of 3 proves that the replay, the carrier scan on an already delivered shipment and the refused second mark added no notice, and that nothing went to the seller. Stores the sorted ids in msNoticeIds.
}
