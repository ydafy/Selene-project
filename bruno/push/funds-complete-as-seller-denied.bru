meta {
  name: funds-complete-as-seller-denied
  type: http
  seq: 205
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_complete_shipment_transfer
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{fdSellerToken}}
}

body:json {
  {
    "p_run_id": "{{fdRunId}}",
    "p_shipment_id": "{{fdShipmentId}}",
    "p_expected_stage_version": {{fdStageVersion}},
    "p_transfer_token": "{{fdTransferToken}}",
    "p_stripe_transfer_id": "{{fdTransferId}}"
  }
}

tests {
  test("S4: the seller's own JWT is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_complete_shipment_transfer");
  });
}

docs {
  Authenticated throwaway seller, with the exact arguments of the service-role call. The function is granted to service_role only.
}
