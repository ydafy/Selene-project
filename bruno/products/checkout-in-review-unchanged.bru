meta {
  name: checkout-in-review-unchanged
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/rest/v1/products_public?id=eq.00000000-0000-4000-8000-0000000000b6&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
}

tests {
  test("the refused checkout left the listing IN_REVIEW", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ id: "00000000-0000-4000-8000-0000000000b6", status: "IN_REVIEW" }]);
  });
}

docs {
  Runs right after checkout-in-review-refused.
