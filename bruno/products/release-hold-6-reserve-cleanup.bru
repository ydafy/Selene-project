meta {
  name: release-hold-6-reserve-cleanup
  type: http
  seq: 95
}

post {
  url: {{baseUrl}}/functions/v1/create-connect-payment
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "productIds": ["00000000-0000-4000-8000-0000000000b3"],
    "addressId": "00000000-0000-4000-8000-0000000000a3"
  }
}

tests {
  test("the suspended seller's listing cannot be bought", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.equal("RESERVATION_FAILED");
  });
}

docs {
  Needs buyerToken. fn_reserve_products releases the expired reservation first; with the seller suspended the listing is held (HIDDEN) instead of returning to VERIFIED, and the purchase fails. The next request proves the listing state.
}
