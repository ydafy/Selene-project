meta {
  name: unlock-product-10-state
  type: http
  seq: 80
}

get {
  url: {{baseUrl}}/rest/v1/products?id=eq.00000000-0000-4000-8000-0000000000b4&select=locked_by,locked_at
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the listing is unlocked", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].locked_by).to.equal(null);
    expect(res.getBody()[0].locked_at).to.equal(null);
  });
}

docs {
  Service-role read after unlock-product-09. unlock-product-11 checks the audit row.
