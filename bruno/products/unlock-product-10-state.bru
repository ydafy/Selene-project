meta {
  name: unlock-product-10-state
  type: http
  seq: 80
}

get {
  url: {{baseUrl}}/rest/v1/product_verifications?product_id=eq.00000000-0000-4000-8000-0000000000b6&decision=is.null&select=locked_by,locked_at
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("the open attempt is unlocked and still open", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].locked_by).to.equal(null);
    expect(res.getBody()[0].locked_at).to.equal(null);
  });
}

docs {
  Service-role read after unlock-product-09. The lock lives on the open verification attempt (#651 S4). unlock-product-11 checks the audit row.
}
