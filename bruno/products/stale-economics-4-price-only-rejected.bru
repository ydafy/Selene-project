meta {
  name: stale-economics-4-price-only-rejected
  type: http
  seq: 102
}

patch {
  url: {{baseUrl}}/rest/v1/products?id=eq.{{staleEconId}}
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
  Prefer: return=representation
}

body:json {
  { "price": 8100, "status": "PENDING_VERIFICATION" }
}

tests {
  test("a price change that keeps the old snapshot is refused as stale", function () {
    expect(res.getStatus()).to.be.within(400, 499);
    expect(JSON.stringify(res.getBody())).to.contain("INVALID_OR_STALE_PUBLICATION_ECONOMICS");
  });
}
