meta {
  name: unlock-product-06-anon-denied
  type: http
  seq: 76
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_unlock_product
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_product_id": "00000000-0000-4000-8000-0000000000b4"
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
    expect(res.getBody().message).to.equal("permission denied for function fn_unlock_product");
  });
}

docs {
  EXECUTE on fn_unlock_product is not granted to anon.
}
