meta {
  name: unlock-product-03-suspended-admin-denied
  type: http
  seq: 73
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_unlock_product
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "p_product_id": "00000000-0000-4000-8000-0000000000b4"
  }
}

tests {
  test("a suspended admin with a live session is refused", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("P0001");
    expect(res.getBody().message).to.equal("UNAUTHORIZED_ADMIN_ONLY");
  });
}

docs {
  Suspension does not end the session, so the admin check inside the function must read the
  current status (is_admin()). unlock-product-07 proves the lock is unchanged.
}
