meta {
  name: verified-edit-5-cleanup
  type: http
  seq: 113
}

patch {
  url: {{baseUrl}}/rest/v1/products?id=eq.{{verifiedEditId}}
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

body:json {
  { "status": "HIDDEN", "deleted_at": "2026-01-01T00:00:00Z" }
}

tests {
  test("the test listing is hidden and soft-deleted", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].deleted_at).to.be.a("string");
  });
}
