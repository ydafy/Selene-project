meta {
  name: products-public-embed-order-items-dual
  type: http
  seq: 56
}

get {
  url: {{baseUrl}}/rest/v1/shipments?select=id,items:order_items(id,product:products(id),public_product:products_public(id))&limit=1
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("shipments embed order items with both the table and the view product", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Same shape as ITEM_PRODUCT_EMBED in useOrders/useShipments: owners get the table row, everyone else the view row. The seed has no orders, so the proof is that PostgREST resolves both embeds on one order item without an ambiguity error.
}
