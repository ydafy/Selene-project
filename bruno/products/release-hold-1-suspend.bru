meta {
  name: release-hold-1-suspend
  type: http
  seq: 90
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_admin_update_user_status
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "p_target_user_id": "00000000-0000-4000-8000-000000000002",
    "p_admin_id": "00000000-0000-4000-8000-000000000001",
    "p_new_status": "suspended",
    "p_reason": "bruno release hold"
  }
}

tests {
  test("the admin changes the seller status", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.equal(true);
  });
}

docs {
  Suspends the seeded seller. T9e2 flow (release-hold-*), run in order after auth/login-admin, auth/login-buyer and the functions server; it ends with release-hold-9-restored, which returns the seeded seller and listing to their start state.
}
