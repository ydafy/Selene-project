meta {
  name: products-public-select-star-allow-list
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/rest/v1/products_public?id=eq.00000000-0000-4000-8000-0000000000b1&select=*
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}

}

tests {
  test("select=* returns exactly the allow-listed keys", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(Object.keys(rows[0]).sort()).to.deep.equal([
      "aspect_ratio", "category", "condition", "created_at", "description", "fts", "id", "images",
      "name", "price", "seller_id", "specifications", "status", "usage", "views"
    ]);
  });
}

docs {
  No hidden column leaks through select=*.
}
