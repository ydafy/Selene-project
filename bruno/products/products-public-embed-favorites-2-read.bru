meta {
  name: products-public-embed-favorites-2-read
  type: http
  seq: 50
}

get {
  url: {{baseUrl}}/rest/v1/favorites?user_id=eq.00000000-0000-4000-8000-000000000003&select=product:products_public!inner(*)
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("the favorites embed through products_public returns allow-listed keys only", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(rows[0].product.id).to.equal("00000000-0000-4000-8000-0000000000b1");
    expect(Object.keys(rows[0].product).sort()).to.deep.equal([
      "aspect_ratio", "category", "condition", "created_at", "description", "fts", "id", "images",
      "name", "price", "seller_id", "specifications", "status", "usage", "views"
    ]);
  });
}

docs {
  Same select as fetchMyFavorites / fetchAllFavorites. A buyer needs no products table row for it.
}
