meta {
  name: products-public-anon-sees-verified
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/rest/v1/products_public?id=eq.00000000-0000-4000-8000-0000000000b1&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}

}

tests {
  test("a guest reads a VERIFIED listing from the view", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ id: "00000000-0000-4000-8000-0000000000b1", status: "VERIFIED" }]);
  });
}

docs {
  products_public returns live public rows to anon. Seeded in supabase/seed.sql.
}
