meta {
  name: products-table-seller-reads-own-hidden-states
  type: http
  seq: 63
}

get {
  url: {{baseUrl}}/rest/v1/products?id=in.(00000000-0000-4000-8000-0000000000b7,00000000-0000-4000-8000-0000000000b9,00000000-0000-4000-8000-0000000000ba)&select=id,status&order=id
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
}

tests {
  test("the seller also reads their REJECTED, HIDDEN and soft-deleted listings from the table", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([
      { id: "00000000-0000-4000-8000-0000000000b7", status: "REJECTED" },
      { id: "00000000-0000-4000-8000-0000000000b9", status: "HIDDEN" },
      { id: "00000000-0000-4000-8000-0000000000ba", status: "VERIFIED" }
    ]);
  });
}

docs {
  Owner policy has no status or deleted_at filter. Run after auth/login-seller.
}
