meta {
  name: release-as-anon-denied
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_release_products
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "p_product_ids": ["00000000-0000-4000-8000-0000000000b1"]
  }
}

tests {
  test("an anonymous caller is denied", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Proves EXECUTE on fn_release_products is revoked from `anon`.
}
