meta {
  name: unlock-product-12-verified-not-open
  type: http
  seq: 82
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_lock_product
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "p_product_id": "00000000-0000-4000-8000-0000000000b4"
  }
}

tests {
  test("an admin cannot lock a listing without an open verification attempt", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("P0001");
    expect(res.getBody().message).to.equal("VERIFICATION_NOT_OPEN");
  });
}

docs {
  Run after auth/login-admin. The seeded listing b4 is verified and its only attempt is approved, so there
  is nothing to review (#651 S4).
}
