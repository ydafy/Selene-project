meta {
  name: unlock-product-07-lock-unchanged
  type: http
  seq: 77
}

get {
  url: {{baseUrl}}/rest/v1/products?id=eq.00000000-0000-4000-8000-0000000000b4&select=locked_by,locked_at
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the refused calls left the admin's lock in place", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].locked_by).to.equal("00000000-0000-4000-8000-000000000001");
    expect(res.getBody()[0].locked_at).to.not.equal(null);
  });
}

docs {
  Service-role read after unlock-product-03, unlock-product-05 and unlock-product-06.
}
