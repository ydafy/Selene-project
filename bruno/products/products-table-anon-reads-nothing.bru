meta {
  name: products-table-anon-reads-nothing
  type: http
  seq: 60
}

get {
  url: {{baseUrl}}/rest/v1/products?id=eq.00000000-0000-4000-8000-0000000000b1&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{publishableKey}}
}

tests {
  test("a guest cannot read the products table, even a VERIFIED row", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  anon has no privilege on the products table (#305; the contract is supabase/tests/database/client_grants.test.sql). Public reads go through products_public.
}
