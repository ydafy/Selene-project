meta {
  name: products-table-anon-reads-nothing
  type: http
  seq: 60
}

get {
  url: {{baseUrl}}/rest/v1/products?id=eq.00000000-0000-4000-8000-0000000000b1&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
}

tests {
  test("a guest reads no row from the products table, even a VERIFIED one", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  products_select_public was dropped (T4d3): the table is closed to non-owners. Public reads go through products_public.
}
