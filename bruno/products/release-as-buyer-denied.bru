meta {
  name: release-as-buyer-denied
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_release_products
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "p_product_ids": ["00000000-0000-4000-8000-0000000000b1"]
  }
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Run after auth/login-buyer (needs `buyerToken`). Proves EXECUTE on
  fn_release_products is revoked from `authenticated`: buyers cannot release inventory.
}
