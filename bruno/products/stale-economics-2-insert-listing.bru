meta {
  name: stale-economics-2-insert-listing
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/rest/v1/products
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

script:pre-request {
  function reserve(price, shipping, buffer, insurance) {
    return Math.round(shipping * 100) + buffer + Math.ceil(Math.round(price * 100) * insurance);
  }
  const buffer = Number(bru.getVar("staleEconBuffer"));
  const insurance = Number(bru.getVar("staleEconInsurance"));
  req.setBody({
    name: "Stale economics GPU",
    description: "Bruno fixture for publication economics",
    price: 8000,
    category: "GPU",
    condition: "used",
    usage: "gaming",
    images: ["https://placehold.co/800x800/png?text=Stale"],
    status: "VERIFIED",
    specifications: { chipset: "NVIDIA", brand: "MSI", model: "RTX 3070", memory: "8 GB" },
    seller_id: "00000000-0000-4000-8000-000000000002",
    shipping_cost: 100,
    origin_zip: "06600",
    package_preset: "gpu_1",
    verified_at: new Date().toISOString(),
    publication_shipping_reserve_cents: reserve(8000, 100, buffer, insurance),
    publication_commission_rate: Number(bru.getVar("staleEconCommission")),
    publication_insurance_rate: insurance
  });
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("staleEconId", res.getBody()[0].id);
    bru.setVar("staleEconReserve", res.getBody()[0].publication_shipping_reserve_cents);
  }
}

tests {
  test("the seeded seller gets a VERIFIED listing with a fresh snapshot", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()[0].status).to.equal("VERIFIED");
  });
}
