meta {
  name: public-sees-pending-verification
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/rest/v1/products_public?id=eq.00000000-0000-4000-8000-0000000000b5&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{publishableKey}}
}

tests {
  test("a guest sees a listing that is pending_verification", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ id: "00000000-0000-4000-8000-0000000000b5", status: "pending_verification" }]);
  });
}

docs {
  products_public shows pending_verification to guests (the table policy was dropped in T4d3). Seeded in supabase/seed.sql.
}
