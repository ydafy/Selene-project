meta {
  name: payment-readiness-as-anon
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_product_seller_payment_readiness
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  {
    "p_product_ids": [
      "00000000-0000-4000-8000-0000000000b1",
      "00000000-0000-4000-8000-0000000000ff"
    ]
  }
}

tests {
  test("a guest learns only whether the seller of a VERIFIED listing accepts payments", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([
      { product_id: "00000000-0000-4000-8000-0000000000b1", seller_accepts_payments: false }
    ]);
  });
}

docs {
  The seeded seller has a Connect account with pending onboarding (supabase/seed.sql), so
  the answer is false. Unknown ids are omitted. No account id or status is exposed.
}
