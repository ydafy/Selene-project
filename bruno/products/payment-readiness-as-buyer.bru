meta {
  name: payment-readiness-as-buyer
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_product_seller_payment_readiness
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "p_product_ids": ["00000000-0000-4000-8000-0000000000b2"]
  }
}

tests {
  test("a signed-in buyer gets the same boolean", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([
      { product_id: "00000000-0000-4000-8000-0000000000b2", seller_accepts_payments: false }
    ]);
  });
}

docs {
  Run after auth/login-buyer (needs `buyerToken`).
}
