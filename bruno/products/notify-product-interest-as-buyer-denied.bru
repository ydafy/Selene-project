meta {
  name: notify-product-interest-as-buyer-denied
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_notify_product_interest
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "p_product_id": "00000000-0000-4000-8000-0000000000b1",
    "p_favoriter_id": "00000000-0000-4000-8000-000000000003"
  }
}

tests {
  test("an authenticated buyer is denied", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  Run after auth/login-buyer (needs `buyerToken`). Proves EXECUTE on
  fn_notify_product_interest is revoked from `authenticated`: buyers cannot
  fabricate "interest" notices for other users.
}
