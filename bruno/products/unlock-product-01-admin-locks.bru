meta {
  name: unlock-product-01-admin-locks
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_lock_product
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "p_product_id": "00000000-0000-4000-8000-0000000000b4"
  }
}

tests {
  test("the admin takes the review lock", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].success).to.equal(true);
  });
}

docs {
  Run after auth/login-admin, auth/login-buyer. Precondition for the fn_unlock_product checks (#66):
  the admin holds the review lock on the seeded listing b4. unlock-product-09 releases it.
}
