meta {
  name: reconcile-stripe-fees-setup-job
  type: http
  seq: 135
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_enqueue_stripe_fee_reconciliation_job
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

script:pre-request {
  bru.setVar("feeJobIntentId", "pi_bruno_fee_" + Date.now());
}

body:json {
  {
    "p_order_id": "00000000-0000-4000-8000-0000000000f0",
    "p_stripe_payment_intent_id": "{{feeJobIntentId}}"
  }
}

tests {
  test("the service role queues a new fee job", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.equal(true);
  });
}

docs {
  Queues one due job on the seeded order f0 with a payment intent id unique to this run, so
  reruns do not collide. The job lives in schema internal, so the requests below see it only
  through the RPCs; reconcile-stripe-fees-cleanup-job leaves it failed, never due again.
  The worker's no-charge retry and the lease expiry run in
  scripts/verify/verify-stripe-fee-lease-recovery.ts, which can read and delete job rows.
}
