meta {
  name: create-dispute-anon-key
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/functions/v1/create-dispute
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {
    "orderId": "00000000-0000-4000-8000-0000000000c1",
    "shipmentId": "00000000-0000-4000-8000-0000000000c2",
    "reason": "Bruno: anon key",
    "description": "Bruno anon key request, never reaches the database",
    "evidence": {
      "images": ["https://example.test/evidence-1.jpg"],
      "tech_checklist": { "powers_on": true }
    }
  }
}

tests {
  test("a valid JWT that is not a user session is refused with the stable code", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "AUTH_REQUIRED" });
  });
}

docs {
  The anon key passes the gateway but is not a user session, so create-dispute must refuse it with
  AUTH_REQUIRED before reading any row or calling Stripe or Envia.
}
