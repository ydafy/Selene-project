tests {
  test("only the admin's note exists: the refused requests wrote nothing", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([
      { id: bru.getVar("poNoteId"), shipment_id: bru.getVar("poShipment") },
    ]);
  });
}

