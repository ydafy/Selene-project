meta {
  name: refund-overdue-payout-no-auth
  type: http
  seq: 184
}

post {
  url: {{baseUrl}}/functions/v1/refund-overdue-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
}

script:pre-request {
  req.setBody({ shipment_id: bru.getVar("roOldShipment") });
}

body:json {
  {}
}

tests {
  test("a request without a session is AUTH_REQUIRED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "AUTH_REQUIRED" });
  });
}

docs {
  verify_jwt = false: the function refuses the request before any lookup.
}
