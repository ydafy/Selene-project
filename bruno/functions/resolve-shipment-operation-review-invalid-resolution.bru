meta {
  name: resolve-shipment-operation-review-invalid-resolution
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/functions/v1/resolve-shipment-operation-review
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  { "shipment_id": "00000000-0000-4000-8000-0000000000d1", "resolution": "refund_failed", "note": "Bruno: invalid resolution" }
}

tests {
  test("an admin gets a stable validation code for an unknown resolution", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.deep.equal({ error: "INVALID_REVIEW_RESOLUTION" });
  });
}

docs {
  Run after functions/login-admin (needs adminToken).
}
