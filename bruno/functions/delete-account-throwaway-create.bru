meta {
  name: delete-account-throwaway-create
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/auth/v1/admin/users
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  bru.setVar("deleteThrowawayEmail", "bruno-delete-" + Date.now() + "@selene.local");
}

body:json {
  {
    "email": "{{deleteThrowawayEmail}}",
    "password": "password123",
    "email_confirm": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("deleteThrowawayId", res.getBody().id);
  }
}

tests {
  test("creates a confirmed throwaway user through the local admin API", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. Each run makes its own user, so closing it leaves the seed accounts
  untouched and the collection repeatable.
}
