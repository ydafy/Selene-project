meta {
  name: checkout-recovery-worker-with-secret
  type: http
  seq: 148
}

post {
  url: {{baseUrl}}/functions/v1/checkout-recovery-worker
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and runs, or skips while the lease is held", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.received).to.equal(true);
    if (body.skipped !== true) {
      expect(body.processed).to.equal(body.results.length);
    }
  });
}

docs {
  Needs the functions server and CRON_SECRET in the functions env file. The worker builds its
  client from the default secret key in SUPABASE_SECRET_KEYS and takes the run lease, which
  checkout-recovery-lease-release-holder freed earlier. The seed has no recovery shell, so a
  run normally processes none; the test does not depend on that count.
}
