meta {
  name: stripe-webhooks-unsigned
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/functions/v1/stripe-webhooks
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects a request without a Stripe signature", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.equal("No signature");
  });
}

docs {
  Needs the functions server: run `bun run functions:serve` right before the calls (it exits about 60 s after the last request).
  Proves the webhook refuses unsigned calls before touching any data.
}
