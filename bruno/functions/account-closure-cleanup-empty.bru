meta {
  name: account-closure-cleanup-empty
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/functions/v1/account-closure-cleanup
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and finds nothing to retry", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({
      claimed: 0,
      completed: 0,
      failed: 0,
      invalid: 0,
      capped: [],
    });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. Every closure
  the collection makes is finished, in this run or the one before: delete-account
  finishes its own, and the orders folder (after this one) finishes the closures of its
  fn_close_account calls in orders/*-closure-cleanup. A closure left by an aborted run
  fails this check until `supabase db reset`. The retry of a failed closure and the capped
  list run end to end in scripts/verify/test-account-closure-cleanup.ts, which can age a
  closure.
}
