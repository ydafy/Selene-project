meta {
  name: account-closure-cleanup-empty
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/functions/v1/account-closure-cleanup
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and finds nothing to retry", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({
      claimed: 0,
      completed: 0,
      failed: 0,
      invalid: 0,
      capped: [],
    });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. Runs before the
  failed-closure setup below, and every closure the collection makes is finished by then.
}
