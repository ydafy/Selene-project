meta {
  name: delete-account-no-auth
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/functions/v1/delete-account
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
}

tests {
  test("rejects a call without a user token", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "AUTH_REQUIRED" });
  });
}

docs {
  Needs the functions server (see stripe-webhooks-unsigned). verify_jwt = false, so the
  function's own check answers; nothing is read or changed.
}
