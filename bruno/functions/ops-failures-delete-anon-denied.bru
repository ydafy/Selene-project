tests {
  test("an anonymous caller cannot delete ops failures", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("42501");
  });
}

docs {
  odd/tasks/table-cleanup.md S6b: EXECUTE on fn_delete_ops_failures is revoked from `anon`.
  Sends only the publishable key, as an anonymous client does.
