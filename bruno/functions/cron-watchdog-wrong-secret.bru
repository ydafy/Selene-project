meta {
  name: cron-watchdog-wrong-secret
  type: http
  seq: 153
}

post {
  url: {{baseUrl}}/functions/v1/cron-watchdog
  body: json
  auth: none
}

headers {
  x-cron-secret: not-the-secret
}

body:json {
  {}
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server with CRON_SECRET set. The shared `isAuthorizedCronRequest` check
  refuses the secret before fn_cron_health runs, and `reportCronSecretMismatch` sends one
  Sentry message (only when SENTRY_DSN is set).
}
