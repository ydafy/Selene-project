meta {
  name: reconcile-stripe-fees-job-row
  type: http
  seq: 137
}

get {
  url: {{baseUrl}}/rest/v1/stripe_fee_reconciliation_jobs?id=eq.{{feeJobId}}&select=*
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("the job is pending again with one attempt and a future retry", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(rows[0].status).to.equal("pending");
    expect(rows[0].attempt_count).to.equal(1);
    expect(rows[0].last_error).to.equal("STRIPE_FEE_UNAVAILABLE");
    expect(rows[0].claim_token).to.equal(null);
    expect(rows[0].claim_expires_at).to.equal(null);
    expect(Date.parse(rows[0].next_retry_at)).to.be.above(Date.now());
  });
}

docs {
  Reads the job with the service role. The first retry is 60 s after the run, so a second
  run right away would not claim it again.
}
