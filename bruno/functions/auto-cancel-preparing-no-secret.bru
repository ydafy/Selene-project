meta {
  name: auto-cancel-preparing-no-secret
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/functions/v1/auto-cancel-preparing
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("UNAUTHORIZED");
  });
}

docs {
  Needs the functions server (supabase functions serve --no-verify-jwt --env-file supabase/functions/.env)
  with CRON_SECRET set. The local seed has no expired shipments, so a call with the secret finds
  nothing to cancel (or reports a held lease).
}
