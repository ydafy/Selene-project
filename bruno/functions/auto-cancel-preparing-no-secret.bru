meta {
  name: auto-cancel-preparing-no-secret
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/functions/v1/auto-cancel-preparing
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {}
}

tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("UNAUTHORIZED");
  });
}

docs {
  Needs the functions server (bun run functions:serve) with CRON_SECRET set. Like the
  production cron job, it sends the anon JWT so the gateway (verify_jwt = true) lets it through.
  The local seed has no expired shipments, so a call with the secret finds nothing to cancel (or reports a held lease).
}
