meta {
  name: checkout-recovery-worker-wrong-secret
  type: http
  seq: 147
}

post {
  url: {{baseUrl}}/functions/v1/checkout-recovery-worker
  body: json
  auth: none
}

headers {
  x-cron-secret: wrong-secret-value
}

body:json {
  {}
}

tests {
  test("rejects the worker with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.equal("Unauthorized");
  });
}

docs {
  Needs the functions server and CRON_SECRET in the functions env file. The handler refuses
  the secret before it takes the lease or calls Stripe.
}
