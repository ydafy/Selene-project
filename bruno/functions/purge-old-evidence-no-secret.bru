tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. Proves the evidence purge is closed to callers without
  x-cron-secret.
}
