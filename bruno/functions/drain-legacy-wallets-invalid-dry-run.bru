meta {
  name: drain-legacy-wallets-invalid-dry-run
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/functions/v1/drain-legacy-wallets
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "dryRun": "yes"
  }
}

tests {
  test("a non-boolean dryRun fails with one invalid_type issue", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.success).to.equal(false);
    const issues = JSON.parse(body.error);
    expect(issues).to.have.length(1);
    expect(issues[0].code).to.equal("invalid_type");
    expect(issues[0].path).to.deep.equal(["dryRun"]);
  });
}

docs {
  The body `error` is zod 4's `ZodError.message` (JSON of issues). Validation runs after the
  admin check and before the wallets read or any transfer, so no wallet is drained. Run after
  auth/login-admin.
}
