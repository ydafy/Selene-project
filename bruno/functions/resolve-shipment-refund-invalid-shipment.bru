meta {
  name: resolve-shipment-refund-invalid-shipment
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/functions/v1/resolve-shipment-refund
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "shipment_id": "not-a-uuid",
    "reference": "Bruno: invalid shipment"
  }
}

tests {
  test("an admin gets a stable validation code for a malformed shipment id", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.deep.equal({ error: "INVALID_SHIPMENT_ID" });
  });
}

docs {
  Run after login-admin (needs `adminToken`). Proves an admin reaches body validation.
}
