meta {
  name: list-shipment-operation-reviews-buyer
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/functions/v1/list-shipment-operation-reviews
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

tests {
  test("a signed-in buyer cannot list shipment reviews", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.deep.equal({ error: "ADMIN_ONLY" });
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). A valid non-admin session is stopped before the RPC.
}
