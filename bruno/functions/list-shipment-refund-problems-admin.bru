meta {
  name: list-shipment-refund-problems-admin
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/functions/v1/list-shipment-refund-problems
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

tests {
  test("an admin gets the refund problems list", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().problems).to.be.an("array");
  });
}

docs {
  Run after functions/login-admin (needs adminToken). Read-only; the array is empty on a fresh seed.
}
