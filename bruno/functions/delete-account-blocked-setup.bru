  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "id": "00000000-0000-4000-8000-0000000000d1",
    "buyer_id": "00000000-0000-4000-8000-000000000003",
    "total_amount": 1,
    "shipping_address": {},
    "status": "paid"
  }
}

tests {
  test("the seeded buyer has one order that is not finished", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()[0].status).to.equal("paid");
  });
}

docs {
  Local stack only. Gives the seeded buyer one pending obligation (an unfinished
  order) for delete-account-blocked. delete-account-blocked-cleanup removes it.
}
