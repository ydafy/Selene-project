meta {
  name: list-shipment-late-carrier-activity-admin
  type: http
  seq: 89
}

get {
  url: {{baseUrl}}/functions/v1/list-shipment-late-carrier-activity
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

tests {
  test("an admin gets the late carrier activity list", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().late_carrier_activity).to.be.an("array");
  });
}

docs {
  Run after functions/login-admin (needs adminToken). Read-only; the array is empty on a fresh seed.
}
