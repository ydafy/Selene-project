meta {
  name: delete-account-throwaway-row
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_close_account
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

body:json {
  { "p_user_id": "{{deleteThrowawaySub}}" }
}

tests {
  test("the closure is recorded and its cleanup finished", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("already_closed");
    expect(body.stripe_customer_cleanup).to.equal("not_needed");
    expect(body.stripe_account_cleanup).to.equal("not_needed");
    expect(body.storage_cleanup).to.equal("done");
  });
}

docs {
  account_closures lives in schema internal, out of PostgREST's reach, so the closure is
  read back through fn_close_account with the service role: a second call changes nothing
  and reports the stored cleanup state. storage_cleanup done proves delete-account recorded
  the step through fn_record_closure_cleanup_step. The attempt count and last_error are
  pinned in supabase/tests/database/account_closure*.test.sql.
}
