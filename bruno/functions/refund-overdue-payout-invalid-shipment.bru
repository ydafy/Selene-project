meta {
  name: refund-overdue-payout-invalid-shipment
  type: http
  seq: 186
}

post {
  url: {{baseUrl}}/functions/v1/refund-overdue-payout
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "shipment_id": "not-a-uuid",
    "amount_cents": 1
  }
}

tests {
  test("a shipment id that is not a uuid is refused", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.deep.equal({ error: "INVALID_SHIPMENT_ID" });
  });
}

docs {
  Run after functions/login-admin. The amount field is ignored: the server computes the refund.
}
