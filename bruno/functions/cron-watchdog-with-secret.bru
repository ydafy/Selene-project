meta {
  name: cron-watchdog-with-secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/functions/v1/cron-watchdog
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and reports the checked jobs", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().checked).to.be.a("number");
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. Read-only
  health check of pg_cron jobs; the watchdog may report to Sentry only if SENTRY_DSN is set.
}
