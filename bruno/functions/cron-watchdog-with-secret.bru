meta {
  name: cron-watchdog-with-secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/functions/v1/cron-watchdog
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and reports the checked jobs", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().checked).to.be.a("number");
  });

  test("drains internal.ops_failures, or names why it kept the rows", function () {
    const ops = res.getBody().opsFailures;
    expect(ops).to.be.an("object");
    if ("error" in ops) {
      // Without SENTRY_DSN nothing is delivered, so the rows stay.
      expect(ops.error).to.equal("OPS_FAILURES_NOT_DELIVERED");
      expect(Object.keys(ops)).to.eql(["error"]);
    } else {
      expect(ops.reported).to.be.a("number");
      expect(ops.deleted).to.equal(ops.reported);
    }
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. Health check of
  pg_cron jobs, then up to 100 internal.ops_failures rows reported to Sentry and deleted once
  Sentry confirms delivery (odd/tasks/table-cleanup.md S6b); without SENTRY_DSN nothing is
  reported and the rows stay.
}
