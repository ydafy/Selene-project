meta {
  name: resume-pending-payouts-no-secret
  type: http
  seq: 129
}

post {
  url: {{baseUrl}}/functions/v1/resume-pending-payouts
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects the worker without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ success: false, error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. verify_jwt is
  false, so the handler's secret check is the only gate.
}
