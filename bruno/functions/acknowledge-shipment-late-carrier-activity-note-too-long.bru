meta {
  name: acknowledge-shipment-late-carrier-activity-note-too-long
  type: http
  seq: 95
}

post {
  url: {{baseUrl}}/functions/v1/acknowledge-shipment-late-carrier-activity
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  { "shipment_id": "00000000-0000-4000-8000-0000000000d1", "note": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }
}

tests {
  test("an admin gets a stable validation code for a note over 200 characters", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.deep.equal({ error: "INVALID_ACKNOWLEDGEMENT_NOTE" });
  });
}

docs {
  Run after functions/login-admin (needs adminToken). The note allows 1-200 characters.
}
