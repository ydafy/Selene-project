meta {
  name: account-closure-cleanup-wrong-secret
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/functions/v1/account-closure-cleanup
  body: json
  auth: none
}

headers {
  x-cron-secret: not-the-cron-secret
}

body:json {
  {}
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. Proves the cleanup retry worker is closed to callers
  with a wrong x-cron-secret (constant-time compare).
}
