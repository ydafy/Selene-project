meta {
  name: dispatch-push-cleanup-token
  type: http
  seq: 112
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_unregister_push_token
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
}

body:json {
  { "p_token": "ExponentPushToken[bruno-dispatch-push-0001]" }
}

tests {
  test("the owner removes its token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
