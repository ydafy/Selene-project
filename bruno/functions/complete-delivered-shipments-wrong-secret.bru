meta {
  name: complete-delivered-shipments-wrong-secret
  type: http
  seq: 145
}

post {
  url: {{baseUrl}}/functions/v1/complete-delivered-shipments
  body: json
  auth: none
}

headers {
  x-cron-secret: not-the-secret
}

body:json {
  {}
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ success: false, error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server (bun run functions:serve) with CRON_SECRET set. The handler
  rejects the secret before it reads any shipment, so the seed f1-f4 stay as they are.
}
