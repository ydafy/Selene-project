meta {
  name: dispatch-push-no-secret
  type: http
  seq: 103
}

post {
  url: {{baseUrl}}/functions/v1/dispatch-push
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. The dispatcher is closed to callers without x-cron-secret.
}
