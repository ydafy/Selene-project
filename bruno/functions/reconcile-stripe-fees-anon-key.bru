meta {
  name: reconcile-stripe-fees-anon-key
  type: http
  seq: 133
}

post {
  url: {{baseUrl}}/functions/v1/reconcile-stripe-fees
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
}

body:json {
  {}
}

tests {
  test("a valid JWT without the cron secret is refused by the handler", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.equal("Unauthorized");
  });
}

docs {
  verify_jwt is false, so the anon key bearer reaches the handler, which accepts only the
  `x-cron-secret` header (compared with CRON_SECRET) and ignores any Authorization header.
}
