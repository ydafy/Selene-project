meta {
  name: delete-account-blocked-login
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  {
    "gotrue_meta_security": { "captcha_token": "{{captchaToken}}" },
    "email": "buyer@selene.local",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("deleteBlockedToken", res.getBody().access_token);
  }
}

tests {
  test("signs in the seeded buyer just now", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  A fresh password sign-in carries an amr timestamp of now, which delete-account needs.
}
