meta {
  name: cancel-order-no-auth
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/functions/v1/cancel-order
  body: json
  auth: none
}

body:json {
  {
    "orderId": "00000000-0000-4000-8000-0000000000c1",
    "shipmentId": "00000000-0000-4000-8000-0000000000c2",
    "reason": "Bruno: no auth"
  }
}

tests {
  test("the gateway rejects a cancellation without a JWT before the function runs", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("UNAUTHORIZED_NO_AUTH_HEADER");
  });
}

docs {
  verify_jwt = true (deployed and in supabase/config.toml), so an anonymous call never
  reaches the function; its own AUTH_REQUIRED branch only covers a missing header behind the gateway.
  Needs the functions server (see stripe-webhooks-unsigned). Proves cancel-order refuses
  anonymous callers before reading any order or calling Stripe.
}
