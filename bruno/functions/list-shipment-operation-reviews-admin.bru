meta {
  name: list-shipment-operation-reviews-admin
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/functions/v1/list-shipment-operation-reviews
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{adminToken}}
}

tests {
  test("an admin gets the shipment reviews list", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().reviews).to.be.an("array");
  });
}

docs {
  Run after functions/login-admin (needs adminToken). Read-only; the array is empty on a fresh seed.
}
