meta {
  name: manage-payment-methods-get-setup-config
  type: http
  seq: 122
}

post {
  url: {{baseUrl}}/functions/v1/manage-payment-methods
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "action": "get_setup_config"
  }
}

tests {
  test("the removed get_setup_config action fails with one invalid_value issue", function () {
    expect(res.getStatus()).to.equal(400);
    const issues = JSON.parse(res.getBody().error);
    expect(issues).to.have.length(1);
    expect(issues[0].code).to.equal("invalid_value");
    expect(issues[0].path).to.deep.equal(["action"]);
  });
}

docs {
  Stripe's sheets own saved cards (odd/tasks/table-cleanup.md, S7b): the old ephemeral-key setup,
  list and delete actions are gone, and the function accepts only `create_customer_session` and
  `create_setup_intent`. Validation runs after the Bearer token check and before the Stripe
  customer lookup, so the request creates nothing. Run after auth/login-buyer.
}
