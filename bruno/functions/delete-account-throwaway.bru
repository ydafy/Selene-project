meta {
  name: delete-account-throwaway
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/functions/v1/delete-account
  body: none
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{deleteThrowawayToken}}
}

tests {
  test("a freshly signed-in user with no obligations is closed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ success: true });
  });
}

docs {
  The throwaway user has no orders, shipments, disputes or payouts, so the RPC closes it
  and the cleanup runs (no Stripe ids, storage folders empty).
}
