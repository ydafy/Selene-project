meta {
  name: resume-pending-payouts-wrong-secret
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/functions/v1/resume-pending-payouts
  body: json
  auth: none
}

headers {
  x-cron-secret: wrong-secret-value
}

body:json {
  {}
}

tests {
  test("rejects the worker with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ success: false, error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env.
}
