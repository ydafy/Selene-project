meta {
  name: generate-return-label-invalid-dispute
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/functions/v1/generate-return-label
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "disputeId": "11111111-2222-3333-4444-555555555555"
  }
}

tests {
  test("a non-RFC dispute id fails with the Spanish message the return screen shows", function () {
    expect(res.getStatus()).to.equal(400);
    const issues = JSON.parse(res.getBody().error);
    expect(issues).to.have.length(1);
    expect(issues[0].code).to.equal("invalid_format");
    expect(issues[0].path).to.deep.equal(["disputeId"]);
    expect(issues[0].message).to.equal("ID de disputa inválido");
  });
}

docs {
  The body `error` is zod 4's `ZodError.message` (JSON of issues); the return-label screen shows
  it in a toast. Validation runs before auth, Envia and any database read, so no label is bought.
  zod 3.23.8 accepted this id. Run after auth/login-buyer.
}
