meta {
  name: resume-pending-payouts-with-secret
  type: http
  seq: 131
}

post {
  url: {{baseUrl}}/functions/v1/resume-pending-payouts
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and finds no payout run to resume", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({
      success: true,
      claimed: 0,
      resumed: 0,
      deferred: 0,
      skipped: 0,
      actionRequired: 0,
      errors: 0,
      results: [],
    });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env. The seed and the
  collection create no awaiting-balance payout run, so nothing is claimed and Stripe is not
  called.
}
