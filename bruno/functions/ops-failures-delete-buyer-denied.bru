meta {
  name: ops-failures-delete-buyer-denied
  type: http
  seq: 195
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_delete_ops_failures
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  { "p_ids": [1] }
}

tests {
  test("an authenticated buyer cannot delete ops failures", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}

