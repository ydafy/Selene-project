meta {
  name: create-dispute-foreign-evidence
  type: http
  seq: 122
}

post {
  url: {{baseUrl}}/functions/v1/create-dispute
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  {
    "orderId": "00000000-0000-4000-8000-0000000000c1",
    "shipmentId": "00000000-0000-4000-8000-0000000000c2",
    "reason": "damaged",
    "description": "Bruno evidence path check, never reaches the database",
    "evidence": {
      "images": ["disputes/00000000-0000-4000-8000-0000000000c1/00000000-0000-4000-8000-0000000000c3/evidence-1.jpg"],
      "tech_checklist": { "powers_on": false }
    }
  }
}

tests {
  test("evidence outside the caller's folder for the order is refused", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({
      error: "Evidence images must be your uploads for this order",
    });
  });
}

docs {
  Run after auth/login-buyer (needs buyerToken). Dispute evidence must be object paths under
  disputes/<orderId>/<caller id>/ in the evidence bucket; any other path or a URL is refused
  with a 400 before fn_open_shipment_dispute runs.
}
