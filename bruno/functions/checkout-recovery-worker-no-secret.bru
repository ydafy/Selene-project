meta {
  name: checkout-recovery-worker-no-secret
  type: http
  seq: 146
}

post {
  url: {{baseUrl}}/functions/v1/checkout-recovery-worker
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects the worker without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.equal("Unauthorized");
  });
}

docs {
  Needs the functions server and CRON_SECRET in the functions env file. verify_jwt is false,
  so the handler's secret check is the only gate.
}
