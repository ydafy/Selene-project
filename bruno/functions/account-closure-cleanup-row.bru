meta {
  name: account-closure-cleanup-row
  type: http
  seq: 48
}

get {
  url: {{baseUrl}}/rest/v1/account_closures?user_id=eq.{{cleanupThrowawayId}}&select=*
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("storage is done and the claim counted exactly one attempt", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(rows[0].storage_cleanup).to.equal("done");
    expect(rows[0].stripe_customer_cleanup).to.equal("not_needed");
    expect(rows[0].stripe_account_cleanup).to.equal("not_needed");
    expect(rows[0].attempts).to.equal(4);
    expect(rows[0].last_error).to.equal(null);
  });
}

docs {
  Reads account_closures with the service role. attempts 3 before the run, 4 after: the
  claim added the only attempt and the worker did not count a second one.
}
