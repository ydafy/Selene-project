meta {
  name: purge-old-evidence-wrong-secret
  type: http
  seq: 161
}

post {
  url: {{baseUrl}}/functions/v1/purge-old-evidence
  body: json
  auth: none
}

headers {
  x-cron-secret: not-the-cron-secret
}

body:json {
  {}
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. Proves the evidence purge is closed to callers with a
  wrong x-cron-secret (constant-time compare).
}
