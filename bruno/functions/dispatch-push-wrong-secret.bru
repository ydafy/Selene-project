meta {
  name: dispatch-push-wrong-secret
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/functions/v1/dispatch-push
  body: json
  auth: none
}

headers {
  x-cron-secret: not-the-cron-secret
}

body:json {
  {}
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. Constant-time compare against CRON_SECRET.
}
