meta {
  name: cron-watchdog-no-secret
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/functions/v1/cron-watchdog
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server (see stripe-webhooks-unsigned). Proves cron-watchdog is
  closed to callers without x-cron-secret.
}
