meta {
  name: payout-overdue-cleanup-shipment
  type: http
  seq: 179
}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{poShipment}}
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "cancelled"
  }
}

tests {
  test("the fixture shipment is closed and leaves the overdue bucket", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].status).to.equal("cancelled");
  });
}

docs {
  Local stack only. The append-only hold note keeps the shipment row, so it is closed instead of
  deleted.
}
