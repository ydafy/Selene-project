meta {
  name: account-closure-cleanup-no-secret
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/functions/v1/account-closure-cleanup
  body: json
  auth: none
}

body:json {
  {}
}

tests {
  test("rejects a call without the cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "CRON_UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server. Proves the cleanup retry worker is closed to callers
  without x-cron-secret.
}
