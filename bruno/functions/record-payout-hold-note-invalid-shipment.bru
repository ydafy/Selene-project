meta {
  name: record-payout-hold-note-invalid-shipment
  type: http
  seq: 173
}

post {
  url: {{baseUrl}}/functions/v1/record-payout-hold-note
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "shipment_id": "not-a-uuid",
    "note": "Bruno: invalid shipment"
  }
}

tests {
  test("a malformed shipment id is refused with a stable code", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.deep.equal({ error: "INVALID_SHIPMENT_ID" });
  });
}

docs {
  Run after functions/login-admin.
}
