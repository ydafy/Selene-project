meta {
  name: reconcile-stripe-fees-empty
  type: http
  seq: 134
}

post {
  url: {{baseUrl}}/functions/v1/reconcile-stripe-fees
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and finds no due job", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({
      selected: 0,
      succeeded: 0,
      retryScheduled: 0,
      failed: 0,
      errors: 0,
    });
  });
}

docs {
  Needs the functions server and CRON_SECRET in supabase/functions/.env (`bun run bruno:env`
  copies it to bruno/.env). Runs before the job setup below; the seed has no fee
  reconciliation job.
}
