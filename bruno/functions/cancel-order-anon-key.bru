meta {
  name: cancel-order-anon-key
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/functions/v1/cancel-order
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{publishableKey}}
}

body:json {
  {
    "orderId": "00000000-0000-4000-8000-0000000000c1",
    "shipmentId": "00000000-0000-4000-8000-0000000000c2",
    "reason": "Bruno: anon key"
  }
}

tests {
  test("a valid JWT that is not a user session is refused before any order is read", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "AUTH_REQUIRED" });
  });
}

docs {
  The publishable key is not a user session (verify_jwt = false: the gateway checks nothing), so
  cancel-order must refuse it before reading any order or calling Stripe. The error code is
  the function's contract (it used to be the Spanish text "No autorizado").
}
