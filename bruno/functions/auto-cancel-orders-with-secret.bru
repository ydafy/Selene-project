meta {
  name: auto-cancel-orders-with-secret
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/functions/v1/auto-cancel-orders
  body: json
  auth: none
}

headers {
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and runs", function () {
    expect(res.getStatus()).to.equal(200);
    expect(["No shipments to cancel", "Already running"]).to.include(res.getBody().message);
  });
}

docs {
  Needs the functions server (supabase functions serve --no-verify-jwt --env-file supabase/functions/.env)
  with CRON_SECRET set. The local seed has no expired shipments, so a call with the secret finds
  nothing to cancel (or reports a held lease).
}
