meta {
  name: auto-cancel-orders-with-secret
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/functions/v1/auto-cancel-orders
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{anonKey}}
  x-cron-secret: {{cronSecret}}
}

body:json {
  {}
}

tests {
  test("accepts the cron secret and runs", function () {
    expect(res.getStatus()).to.equal(200);
    expect(["No shipments to cancel", "Already running"]).to.include(res.getBody().message);
  });
}

docs {
  Needs the functions server (bun run functions:serve) with CRON_SECRET set. Like the
  production cron job, it sends the anon JWT so the gateway (verify_jwt = true) lets it through.
  The local seed has no expired shipments, so a call with the secret finds nothing to cancel (or reports a held lease).
}
