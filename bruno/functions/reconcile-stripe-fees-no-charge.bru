meta {
  name: reconcile-stripe-fees-no-charge
  type: http
  seq: 136
}

post {
  url: {{baseUrl}}/functions/v1/reconcile-stripe-fees
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.STRIPE_FEE_RECONCILIATION_WORKER_SECRET}}
}

body:json {
  {}
}

tests {
  test("claims the job and schedules a retry without a Stripe call", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({
      selected: 1,
      succeeded: 0,
      retryScheduled: 1,
      failed: 0,
      errors: 0,
    });
  });
}

docs {
  Run after reconcile-stripe-fees-setup-job. The order has no charge id, so no fee is
  available and the claimed job goes back to pending with a backoff.
}
