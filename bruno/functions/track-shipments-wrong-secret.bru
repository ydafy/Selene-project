meta {
  name: track-shipments-wrong-secret
  type: http
  seq: 152
}

post {
  url: {{baseUrl}}/functions/v1/track-shipments
  body: json
  auth: none
}

headers {
  Authorization: Bearer not-the-secret
}

body:json {
  {
    "lane": "shipped"
  }
}

tests {
  test("rejects a call with a wrong cron secret", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ error: "UNAUTHORIZED" });
  });
}

docs {
  Needs the functions server (bun run functions:serve). The handler compares the Bearer token
  with TRACK_SHIPMENTS_CRON_SECRET in constant time before it reads the body, takes a lease, or
  calls Envia, so the answer is 401 whether or not the secret is set locally.
}
