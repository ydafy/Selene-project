get {
  url: {{baseUrl}}/rest/v1/orders?id=eq.{{orderIdA}}&select=id,status,shipments(status)
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the order is cancelled", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("cancelled");
  });
}

