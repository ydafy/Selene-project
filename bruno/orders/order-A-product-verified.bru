meta {
  name: order-A-product-verified
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/rest/v1/products?id=eq.00000000-0000-4000-8000-0000000000b4
  body: json
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "verified"
  }
}

tests {
  test("the listing is back to verified so the next order can use it", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("verified");
  });
}

docs {
  Local stack only. Restores the seeded listing that order creation marked sold.
}
