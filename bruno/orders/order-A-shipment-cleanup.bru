meta {
  name: order-A-shipment-cleanup
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{shipmentIdA}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "cancelled"
  }
}

tests {
  test("the paid shipment is closed so the seller has no open shipment", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("cancelled");
  });
}

docs {
  Local stack only. Closes the shipment created by order A so the delete-account requests and the collection stay repeatable.
}
