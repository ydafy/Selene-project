meta {
  name: order-A-buyer-notice-cancelled
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/rest/v1/notifications?user_id=eq.{{orderBuyerId}}&title=eq.Pedido Cancelado&select=type,title,action_path
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("Pedido Cancelado is delivered", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].title).to.equal("Pedido Cancelado");
  });
}

docs {
  Notice written by the function.
}
