meta {
  name: order-D-complete-refund-connect
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_complete_shipment_refund
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_shipment_id": "{{shipmentIdD}}"
  }
}

tests {
  test("a Connect shipment is refused: only resolve-dispute-refund marks it refunded", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: false, error_message: "CONNECT_REFUND_REQUIRES_STRIPE" }]);
  });
}

docs {
  Connect refunds are handled by Stripe in resolve-dispute-refund, which records the refund itself; this function refuses Connect shipments before any write.
}
