meta {
  name: summary-G-create-from-payment
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_create_order_from_payment
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  bru.setVar("intentG", "pi_bruno_G_" + Date.now());
}

body:json {
  {
    "p_buyer_id": "{{sumBuyerId}}",
    "p_stripe_intent_id": "{{intentG}}",
    "p_total_amount": 2550,
    "p_service_fee": 150,
    "p_address_id": "{{sumAddressId}}",
    "p_product_ids": [
      "00000000-0000-4000-8000-0000000000b4"
    ]
  }
}

tests {
  test("the payment becomes an order", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, error_message: null }]);
  });
}

docs {
  B5.5 summary flow G: same setup as order B on the seeded listing b4, with its own throwaway buyer.
}
