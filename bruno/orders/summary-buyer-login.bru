meta {
  name: summary-buyer-login
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
}

body:json {
  {
    "email": "{{sumBuyerEmail}}",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("sumBuyerToken", res.getBody().access_token);
  }
}

tests {
  test("signs in the throwaway summary buyer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });
}

docs {
  The buyer of a shipment reads its cancellation summary with its own token.
}
