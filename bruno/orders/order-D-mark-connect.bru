meta {
  name: order-D-mark-connect
  type: http
  seq: 37
}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{shipmentIdD}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "stripe_payment_intent_id": "{{intentD}}"
  }
}

tests {
  test("the shipment carries a Stripe payment intent like a Connect shipment", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].stripe_payment_intent_id).to.equal(bru.getVar("intentD"));
  });
}

