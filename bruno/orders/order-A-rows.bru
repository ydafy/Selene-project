meta {
  name: order-A-rows
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/rest/v1/orders?stripe_payment_intent_id=eq.{{intentA}}&select=id,status,buyer_id,total_amount,shipments(id,status,seller_id),order_items(product_id,seller_id,shipment_id)
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().length === 1) {
    bru.setVar("orderIdA", res.getBody()[0].id);
    bru.setVar("shipmentIdA", res.getBody()[0].shipments[0].id);
  }
}

tests {
  test("one paid order with one paid shipment and one item for the seller", function () {
    expect(res.getStatus()).to.equal(200);
    const orders = res.getBody();
    expect(orders.length).to.equal(1);
    expect(orders[0].status).to.equal("paid");
    expect(orders[0].buyer_id).to.equal(bru.getVar("orderBuyerId"));
    expect(orders[0].shipments.length).to.equal(1);
    expect(orders[0].shipments[0].status).to.equal("paid");
    expect(orders[0].shipments[0].seller_id).to.equal("00000000-0000-4000-8000-000000000002");
    expect(orders[0].order_items.length).to.equal(1);
    expect(orders[0].order_items[0].product_id).to.equal("00000000-0000-4000-8000-0000000000b4");
    expect(orders[0].order_items[0].shipment_id).to.equal(orders[0].shipments[0].id);
  });
}

docs {
  Reads the rows fn_create_order_from_payment wrote and keeps their ids for the next requests.
}
