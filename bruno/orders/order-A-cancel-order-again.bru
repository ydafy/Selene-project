meta {
  name: order-A-cancel-order-again
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_cancel_order
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_order_id": "{{orderIdA}}",
    "p_reason": "Bruno cancellation",
    "p_cancelled_by_role": "buyer"
  }
}

tests {
  test("a second cancel changes nothing", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, error_message: "ALREADY_CANCELLED" }]);
  });
}

docs {
  Idempotency of order cancellation.
}
