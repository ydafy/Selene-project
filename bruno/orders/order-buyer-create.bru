meta {
  name: order-buyer-create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/v1/admin/users
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  bru.setVar("orderBuyerEmail", "bruno-orders-" + Date.now() + "@selene.local");
}

body:json {
  {
    "email": "{{orderBuyerEmail}}",
    "password": "password123",
    "email_confirm": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("orderBuyerId", res.getBody().id);
  }
}

tests {
  test("creates a confirmed throwaway buyer for the order flows", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.be.a("string");
  });
}

docs {
  Local stack only. Each run makes its own buyer, so the collection is repeatable.
  The order flows below run on this buyer and on the seeded seller listing b4.
}
