meta {
  name: order-buyer-close-account
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_close_account
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_user_id": "{{orderBuyerId}}"
  }
}

tests {
  test("finished orders do not block the closure", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("closed");
  });
}

docs {
  fn_close_account (service role). Cancelled and refunded orders are finished, so the buyer closes.
}
