tests {
  test("the sold listing is SOLD", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ id: "00000000-0000-4000-8000-0000000000b4", status: "SOLD" }]);
  });
}

