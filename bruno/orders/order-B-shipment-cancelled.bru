meta {
  name: order-B-shipment-cancelled
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{shipmentIdB}}&select=id,status
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("the shipment is cancelled", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("cancelled");
  });
}

docs {
  Shipment state after the call.
}
