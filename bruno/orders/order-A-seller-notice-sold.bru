meta {
  name: order-A-seller-notice-sold
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/rest/v1/notifications?user_id=eq.00000000-0000-4000-8000-000000000002&action_path=eq./profile/orders/{{orderIdA}}&select=type,title,action_path
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("¡Vendido! is delivered", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    expect(res.getBody()[0].title).to.equal("¡Vendido!");
  });
}

docs {
  Notice written by the function.
}
