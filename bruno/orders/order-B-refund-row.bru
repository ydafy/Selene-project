meta {
  name: order-B-refund-row
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_get_shipment_cancellation_recovery
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

body:json {
  {
    "p_shipment_id": "{{shipmentIdB}}"
  }
}

tests {
  test("the refund is recorded as succeeded", function () {
    expect(res.getStatus()).to.equal(200);
    const { refund_status, refund_id, source } = res.getBody();
    expect({ refund_status, refund_id, source }).to.deep.equal({ refund_status: "succeeded", refund_id: bru.getVar("refundIdB"), source: "buyer" });
  });
}

docs {
  Refund row that gates fn_cancel_shipment, read through fn_get_shipment_cancellation_recovery (the Edge Functions' read); service_role has no privilege on shipment_cancellation_operations.
}
