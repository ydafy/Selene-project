meta {
  name: order-A-create-again
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_create_shipments_from_single_payment
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

script:pre-request {
  req.setBody(JSON.parse(bru.getVar("createBodyA")));
}

body:json {
  {}
}

tests {
  test("a repeat of the same payment is a duplicate of the same order", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().status).to.equal("duplicate");
    expect(res.getBody().order_id).to.equal(bru.getVar("orderIdA"));
  });
}

docs {
  Replays the exact body of order-A-create-from-payment, as a webhook retry would. The function is idempotent on the payment intent: it returns status duplicate with the same order id and writes nothing; order-A-shipment-unchanged runs after it and still sees one shipment.
}
