meta {
  name: summary-G-refunded-seller
  type: http
  seq: 65
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_get_shipment_cancellation_summary
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "p_shipment_id": "{{shipmentIdG}}"
  }
}

tests {
  test("the seller sees refunded once an admin resolved the repayment", function () {
    expect(res.getStatus()).to.equal(200);
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(Object.keys(rows[0]).sort()).to.deep.equal(["refund_state", "refund_updated_at", "source"]);
    expect(rows[0].source).to.equal("seller");
    expect(rows[0].refund_state).to.equal("refunded");
  });
}

docs {
  B5.5 fn_get_shipment_cancellation_summary as a participant: only source, refund_state and refund_updated_at.
}
