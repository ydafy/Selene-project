meta {
  name: submit-14-reject-without-note
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_resolve_product_verdict
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "p_product_id": "{{submitProductId}}",
    "p_verification_id": "{{submitVerificationId}}",
    "p_verdict": "REJECT"
  }
}

tests {
  test("a rejection needs a public note for the seller", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("P0001");
    expect(res.getBody().message).to.equal("REJECTION_NOTE_REQUIRED");
  });
}

docs {
  #651 S5. submit-15 rejects with a note.
}
