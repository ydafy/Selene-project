meta {
  name: submit-09-missing-object
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_submit_product_verification
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "p_product_id": "{{submitProductId}}",
    "p_physical_paths": ["{{submitProductId}}/missing.png"]
  }
}

tests {
  test("every proof must exist in the bucket", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("P0001");
    expect(res.getBody().message).to.equal("EVIDENCE_NOT_FOUND");
  });
}

docs {
  The path is in the right folder, but nothing was uploaded there (#651 S3).
}
