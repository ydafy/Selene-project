meta {
  name: submit-16-attempt-closed
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/rest/v1/product_verifications?id=eq.{{submitVerificationId}}&select=decision,decided_by,decided_at,public_note,locked_by,locked_at
  body: none
  auth: none
}

headers {
  apikey: {{secretKey}}
  Authorization: Bearer {{secretKey}}
}

tests {
  test("the attempt keeps the decision, the reviewer and the note, without a lock", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().length).to.equal(1);
    const row = res.getBody()[0];
    expect(row.decision).to.equal("rejected");
    expect(row.decided_by).to.equal("00000000-0000-4000-8000-000000000001");
    expect(row.decided_at).to.be.a("string");
    expect(row.public_note).to.equal("La foto no muestra el número de serie.");
    expect(row.locked_by).to.equal(null);
    expect(row.locked_at).to.equal(null);
  });
}

docs {
  Service-role read after submit-15 (#651 S5).
}
