meta {
  name: buyer-signs-proof-denied
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/storage/v1/object/sign/verification/00000000-0000-4000-8000-0000000000b1/{{proofName}}
  body: json
  auth: none
}

headers {
  apikey: {{anonKey}}
  Authorization: Bearer {{buyerToken}}
}

body:json {
  { "expiresIn": 60 }
}

tests {
  test("a non-owner gets no signed URL", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().signedURL).to.equal(undefined);
  });
}
