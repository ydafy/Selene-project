meta {
  name: cancel-M6-shipped-no-operation
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/rest/v1/rpc/fn_get_shipment_cancellation_summary
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Authorization: Bearer {{cancBuyerToken}}
}

body:json {
  {
    "p_shipment_id": "{{cancShipmentId}}"
  }
}

tests {
  test("no cancellation operation exists for the shipped shipment", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  Neither refused call may write a cancellation identity.
  The buyer of this order reads fn_get_shipment_cancellation_summary, which returns one row whenever an operation exists for a shipment of theirs (summary-F proves the row); service_role has no privilege on shipment_cancellation_operations.
}
