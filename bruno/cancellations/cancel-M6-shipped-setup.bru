}

patch {
  url: {{baseUrl}}/rest/v1/shipments?id=eq.{{cancShipmentId}}
  body: json
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
  Prefer: return=representation
}

body:json {
  {
    "status": "shipped"
  }
}

tests {
  test("the shipment is moved to shipped", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()[0].status).to.equal("shipped");
  });
}

