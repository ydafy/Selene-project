meta {
  name: cancel-M5-no-operation
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/rest/v1/shipment_cancellation_operations?shipment_id=eq.{{cancShipmentId}}&select=shipment_id
  body: none
  auth: none
}

headers {
  apikey: {{serviceRoleKey}}
  Authorization: Bearer {{serviceRoleKey}}
}

tests {
  test("no cancellation operation was claimed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  The refused call must not write a cancellation identity.
}
