#!/usr/bin/env sh
# A new worktree checks out from the null revision: bring the gitignored env files.
# The script is resolved next to this hook, so it also works for worktrees of branches
# that predate it; it copies into the current directory, the new worktree.
if [ "$1" = "0000000000000000000000000000000000000000" ]; then
  bun "$(dirname "$0")/../scripts/dev/worktree-env.ts" || true
fi
# Branch checkouts (not file checkouts) build or sync the CodeGraph index.
if [ "$3" = "1" ]; then
  sh "$(dirname "$0")/../scripts/dev/codegraph-refresh.sh"
fi
