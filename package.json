{
  "name": "selene-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "supabase"
  ],
  "scripts": {
    "frontend": "cd apps/frontend && bun run start",
    "backend": "cd apps/backend && bun run dev",
    "dev:install": "cd apps/frontend && bunx eas build:dev --platform=android",
    "dashboard": "cd apps/admin-web && bun run dev",
    "db:types": "bunx supabase gen types typescript --project-id acoiclkeymgtlwcxilun --schema public > packages/types/src/database.types.ts",
    "eas:build": "cd apps/frontend && bunx eas build",
    "eas:configure": "cd apps/frontend && bunx eas build:configure",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "bunx prettier --write .",
    "prepare": "bunx husky install || true",
    "clean:all": "bun scripts/clean-all.ts",
    "doctor:frontend": "cd apps/frontend && bunx expo-doctor",
    "fix:frontend": "cd apps/frontend && bunx expo install --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "gentle-engram": "0.1.4"
  }
}
