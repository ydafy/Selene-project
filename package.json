{
  "name": "selene-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "supabase"
  ],
  "scripts": {
    "frontend": "cd apps/frontend && bun run start",
    "backend": "cd apps/backend && bun run dev",
    "dev:install": "cd apps/frontend && bunx eas build:dev --platform=android",
    "dashboard": "cd apps/admin-web && bun run dev",
    "db:test:up": "docker compose -f docker-compose.postgres-test.yml -p selene-pg-shipment-cancellations up -d --wait --wait-timeout 90",
    "db:test:check": "bun scripts/postgres-smoke.ts",
    "db:test:stop": "docker compose -f docker-compose.postgres-test.yml -p selene-pg-shipment-cancellations stop",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "stripe:listen": "bun scripts/stripe-listen.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:types": "bunx supabase gen types typescript --project-id acoiclkeymgtlwcxilun --schema public > packages/types/src/database.types.ts",
    "eas:build": "cd apps/frontend && bunx eas build",
    "eas:configure": "cd apps/frontend && bunx eas build:configure",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "bunx prettier --write .",
    "prepare": "bunx husky install || true",
    "clean:all": "bun scripts/clean-all.ts",
    "doctor:frontend": "cd apps/frontend && bunx expo-doctor",
    "fix:frontend": "cd apps/frontend && bunx expo install --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "zod": "4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "expo-system-ui": "^57.0.2",
    "gentle-engram": "0.1.4"
  }
}
