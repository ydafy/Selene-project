   # Selene Admin Dashboard — Environment Variables (template)
   # Copy this file to `.env` and fill the values for your environment.
   # All VITE_* values are bundled into the browser build — never put
   # server secrets here.

   # --- Supabase (public anon key only) ---
   VITE_SUPABASE_URL=
   VITE_SUPABASE_ANON_KEY=

# hCaptcha site key for the admin login. Empty = no CAPTCHA widget and no token.
# Must be set before CAPTCHA is enabled in the Supabase Dashboard.
VITE_HCAPTCHA_SITE_KEY=
