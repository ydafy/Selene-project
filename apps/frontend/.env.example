# ============================================================================
# Selene Frontend — Environment Variables (template)
# ============================================================================
# Copy this file to `.env` and fill the values for your environment.
# All EXPO_PUBLIC_* values are bundled into the client app — never put
# server secrets here.

# --- Supabase (public anon key only) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google Sign-In ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# --- hCaptcha (Supabase Auth CAPTCHA) ---
# Public site key; the secret lives in the Supabase Dashboard. Leave empty while
# CAPTCHA is off server-side (no token is sent). It must be set in the build
# BEFORE CAPTCHA is enabled in the Dashboard. The hCaptcha test site key
# 10000000-ffff-ffff-ffff-000000000001 is for local development only.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=

# --- Stripe ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx



# --- Support email ---
# Settings > Soporte opens the user's mail app to this address. If it is
# missing or not a valid email, the Soporte row shows the localized
# "support.unavailable" message. Replace the placeholder before release.
EXPO_PUBLIC_SUPPORT_EMAIL=soporte@example.com
